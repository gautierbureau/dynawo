<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <!-- 6th-order round-rotor GENROE machine (CGMES SynchronousMachineTimeConstantReactance, subtransient + roundRotor + saturation)
       with: VCompIEEEType1 voltage compensator, ExcIEEEAC4A voltage regulator, PssIEEE2B power system stabilizer (Pss2b),
             and GovSteam1 (IEEEG1 2005) turbine governor. Matches the CGMES BE-MAS MicroGrid BE-G1 machine. -->
  <dyn:modelicaModel id="GeneratorRoundRotorExpVCompIEEEType1Ac4aPss2bGovSteam1">
    <dyn:unitDynamicModel id="generator" name="Dynawo.Electrical.Machines.OmegaRef.GeneratorRoundRotorExp" initName="Dynawo.Electrical.Machines.OmegaRef.GeneratorRoundRotorExp_INIT"/>
    <dyn:unitDynamicModel id="compensator" name="Dynawo.Electrical.Controls.Machines.VoltageCompensators.Standard.VCompIEEEType1"/>
    <dyn:unitDynamicModel id="voltageRegulator" name="Dynawo.Electrical.Controls.Machines.VoltageRegulators.Standard.Ac4a" initName="Dynawo.Electrical.Controls.Machines.VoltageRegulators.Exciter_INIT"/>
    <dyn:unitDynamicModel id="pss" name="Dynawo.Electrical.Controls.Machines.PowerSystemStabilizers.Standard.Pss2b" initName="Dynawo.Electrical.Controls.Machines.PowerSystemStabilizers.Pss_INIT"/>
    <dyn:unitDynamicModel id="governor" name="Dynawo.Electrical.Controls.Machines.Governors.Standard.Steam.GovSteam1" initName="Dynawo.Electrical.Controls.Machines.Governors.Standard.Steam.GovSteam1_INIT"/>
    <!-- Init connects -->
    <dyn:initConnect id1="voltageRegulator" var1="Efd0Pu" id2="generator" var2="Efd0Pu"/>
    <dyn:initConnect id1="voltageRegulator" var1="Us0Pu" id2="generator" var2="U0PuVar"/>
    <dyn:initConnect id1="governor" var1="Pm0Pu" id2="generator" var2="Pm0Pu"/>
    <dyn:initConnect id1="pss" var1="PGen0Pu" id2="generator" var2="PGen0Pu"/>
    <!-- Compensator taps generator terminal V and I -->
    <dyn:connect id1="compensator" var1="utPu" id2="generator" var2="uPu"/>
    <dyn:connect id1="compensator" var1="itPu" id2="generator" var2="iPu"/>
    <!-- AVR/Compensator/PSS feedback loop -->
    <dyn:connect id1="voltageRegulator" var1="UsPu" id2="compensator" var2="VcPu"/>
    <dyn:connect id1="voltageRegulator" var1="EfdPu" id2="generator" var2="efdPu"/>
    <dyn:connect id1="voltageRegulator" var1="UPssPu" id2="pss" var2="VPssPu"/>
    <!-- Governor / generator mechanical loop -->
    <dyn:connect id1="governor" var1="omegaPu" id2="generator" var2="omegaPu"/>
    <dyn:connect id1="governor" var1="Pm1Pu" id2="generator" var2="PmPu"/>
    <!-- PSS inputs -->
    <dyn:connect id1="pss" var1="PGenPu" id2="generator" var2="PGenPu"/>
    <dyn:connect id1="pss" var1="omegaPu" id2="generator" var2="omegaPu"/>
  </dyn:modelicaModel>
</dyn:dynamicModelsArchitecture>
