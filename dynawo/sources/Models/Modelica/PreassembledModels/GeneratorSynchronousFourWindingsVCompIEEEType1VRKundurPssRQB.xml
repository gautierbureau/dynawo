<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <!-- Machine with four windings, fixed mechanical power, a VCompIEEEType1 load compensator (terminal-side V and I), a Kundur proportional voltage regulator, and a PssRQB stabilizer. -->
  <dyn:modelicaModel id="GeneratorSynchronousFourWindingsVCompIEEEType1VRKundurPssRQB">
    <dyn:unitDynamicModel id="generator" name="Dynawo.Electrical.Machines.OmegaRef.GeneratorSynchronous" initName="Dynawo.Electrical.Machines.OmegaRef.GeneratorSynchronousExt4W_INIT"/>
    <dyn:unitDynamicModel id="compensator" name="Dynawo.Electrical.Controls.Machines.VoltageCompensators.Standard.VCompIEEEType1"/>
    <dyn:unitDynamicModel id="voltageRegulator" name="Dynawo.Electrical.Controls.Machines.VoltageRegulators.Standard.VRKundur" initName="Dynawo.Electrical.Controls.Machines.VoltageRegulators.Exciter_INIT"/>
    <dyn:unitDynamicModel id="pss" name="Dynawo.Electrical.Controls.Machines.PowerSystemStabilizers.Standard.PssRQB" initName="Dynawo.Electrical.Controls.Machines.PowerSystemStabilizers.Pss_INIT"/>
    <dyn:initConnect id1="voltageRegulator" var1="Efd0Pu" id2="generator" var2="Efd0Pu"/>
    <dyn:initConnect id1="voltageRegulator" var1="Us0Pu" id2="generator" var2="UStator0Pu"/>
    <dyn:initConnect id1="pss" var1="PGen0Pu" id2="generator" var2="PGen0Pu"/>
    <dyn:connect id1="compensator" var1="utPu" id2="generator" var2="uPu"/>
    <dyn:connect id1="compensator" var1="itPu" id2="generator" var2="iStatorPu"/>
    <dyn:connect id1="voltageRegulator" var1="UsPu" id2="compensator" var2="VcPu"/>
    <dyn:connect id1="voltageRegulator" var1="efdPu" id2="generator" var2="efdPu"/>
    <dyn:connect id1="voltageRegulator" var1="UPssPu" id2="pss" var2="UPssPu"/>
    <dyn:connect id1="pss" var1="omegaPu" id2="generator" var2="omegaPu"/>
    <dyn:connect id1="pss" var1="PGenPu" id2="generator" var2="PGenPu"/>
  </dyn:modelicaModel>
</dyn:dynamicModelsArchitecture>
