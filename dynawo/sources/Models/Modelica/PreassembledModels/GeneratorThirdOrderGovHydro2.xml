<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <!-- Third-order synchronous machine coupled to a GovHydro2 hydro turbine-governor. -->
  <dyn:modelicaModel id="GeneratorThirdOrderGovHydro2">
    <dyn:unitDynamicModel id="generator" name="Dynawo.Electrical.Machines.OmegaRef.GeneratorThirdOrder" initName="Dynawo.Electrical.Machines.OmegaRef.GeneratorThirdOrder_INIT"/>
    <dyn:unitDynamicModel id="governor" name="Dynawo.Electrical.Controls.Machines.Governors.Standard.Hydraulic.GovHydro2" initName="Dynawo.Electrical.Controls.Machines.Governors.Governor_INIT"/>
    <dyn:initConnect id1="governor" var1="Pm0Pu" id2="generator" var2="Pm0Pu"/>
    <dyn:connect id1="generator" var1="omegaPu" id2="governor" var2="omegaPu"/>
    <dyn:connect id1="generator" var1="PmPu" id2="governor" var2="PmPu"/>
  </dyn:modelicaModel>
</dyn:dynamicModelsArchitecture>
