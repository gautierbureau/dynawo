Fix genex list split for JNI_LIBRARIES / JNI_INCLUDE_DIRS / GRAALVM_INCLUDE_DIRS

CMake list variables expand inside generator expressions with their ';'
separators preserved, which then split the surrounding genex into
multiple arguments. Only the first argument keeps the trailing '>',
leaving e.g. '/opt/graalvm/lib/server/libjvm.so>' as a literal target
name -> "No rule to make target ...libjvm.so>".

Move the conditionals to plain if() blocks so list variables are passed
as proper lists, not embedded inside genex.

This patch is applied locally by dynawo's libiidm ExternalProject_Add as
a stop-gap until the same fix lands upstream.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -97,16 +97,22 @@
         $<BUILD_INTERFACE:${CMAKE_SOURCE_DIR}/include>
         $<INSTALL_INTERFACE:include>
     PRIVATE
-        $<$<BOOL:${IIDM_BRIDGE_ENABLE_JNI}>:${JNI_INCLUDE_DIRS}>
         ${CMAKE_SOURCE_DIR}/src
-        $<$<BOOL:${IIDM_BRIDGE_ENABLE_GRAALVM}>:${GRAALVM_INCLUDE_DIRS}>
 )
+if(IIDM_BRIDGE_ENABLE_JNI)
+    target_include_directories(iidmbridge PRIVATE ${JNI_INCLUDE_DIRS})
+endif()
+if(IIDM_BRIDGE_ENABLE_GRAALVM)
+    target_include_directories(iidmbridge PRIVATE ${GRAALVM_INCLUDE_DIRS})
+endif()

 target_link_libraries(iidmbridge
     PRIVATE
-        $<$<BOOL:${IIDM_BRIDGE_ENABLE_JNI}>:${JNI_LIBRARIES}>
         ${CMAKE_DL_LIBS}
 )
+if(IIDM_BRIDGE_ENABLE_JNI)
+    target_link_libraries(iidmbridge PRIVATE ${JNI_LIBRARIES})
+endif()

 target_compile_definitions(iidmbridge PRIVATE
     $<$<BOOL:${IIDM_BRIDGE_ENABLE_GRAALVM}>:IIDM_BRIDGE_GRAALVM_ENABLED>
