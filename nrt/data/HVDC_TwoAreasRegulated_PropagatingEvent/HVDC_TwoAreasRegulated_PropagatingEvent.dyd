<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">

  <!-- ============== Generators (IEEE14-style synchronous machines with AVR + governor) ============== -->
  <dyn:blackBoxModel id="GEN_A1" lib="GeneratorSynchronousFourWindingsProportionalRegulations" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="GenFourW" staticId="GEN_A1"/>
  <dyn:blackBoxModel id="GEN_A2" lib="GeneratorSynchronousThreeWindingsProportionalRegulations" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="GenThreeW" staticId="GEN_A2"/>
  <dyn:blackBoxModel id="GEN_B1" lib="GeneratorSynchronousFourWindingsProportionalRegulations" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="GenFourW" staticId="GEN_B1"/>
  <dyn:blackBoxModel id="GEN_B2" lib="GeneratorSynchronousThreeWindingsProportionalRegulations" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="GenThreeW" staticId="GEN_B2"/>

  <!-- ============== Loads ============== -->
  <dyn:blackBoxModel id="LOAD_A1" lib="LoadAlphaBeta" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Load" staticId="LOAD_A1"/>
  <dyn:blackBoxModel id="LOAD_A2" lib="LoadAlphaBeta" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Load" staticId="LOAD_A2"/>
  <dyn:blackBoxModel id="LOAD_A3" lib="LoadAlphaBeta" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Load" staticId="LOAD_A3"/>
  <dyn:blackBoxModel id="LOAD_B1" lib="LoadAlphaBeta" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Load" staticId="LOAD_B1"/>
  <dyn:blackBoxModel id="LOAD_B2" lib="LoadAlphaBeta" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Load" staticId="LOAD_B2"/>
  <dyn:blackBoxModel id="LOAD_B3" lib="LoadAlphaBeta" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Load" staticId="LOAD_B3"/>

  <!-- ============== Frequency reference (one barycenter per AC island) ============== -->
  <dyn:blackBoxModel id="OMEGA_REF" lib="DYNModelOmegaRef" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="OmegaRef"/>

  <!-- ============== HVDC link 1: Modelica HvdcPQPropEmulation (overrides the static IIDM HVDC1
       via staticId; ACEmulation makes its active-power reference react to the angle/frequency
       difference between the two AC areas, so Area A disturbances reach Area B) ============== -->
  <dyn:blackBoxModel id="HVDC1" lib="HvdcPQPropEmulation" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="HVDC1" staticId="HVDC1">
    <dyn:staticRef var="hvdc_PInj1Pu" staticVar="p1"/>
    <dyn:staticRef var="hvdc_QInj1Pu" staticVar="q1"/>
    <dyn:staticRef var="hvdc_state" staticVar="state1"/>
    <dyn:staticRef var="hvdc_PInj2Pu" staticVar="p2"/>
    <dyn:staticRef var="hvdc_QInj2Pu" staticVar="q2"/>
    <dyn:staticRef var="hvdc_state" staticVar="state2"/>
  </dyn:blackBoxModel>

  <!-- ============== Load-step event: LOAD_A1 increases by 150 MW at t = 1 s ============== -->
  <dyn:blackBoxModel id="StepP_A1" lib="Step" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="StepP_A1"/>

  <!-- ============== Constant 0 feeds for the HVDC voltage-droop signals (modeU=false; NQ unused) -->
  <dyn:blackBoxModel id="NQ1_feed" lib="Step" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Zero"/>
  <dyn:blackBoxModel id="NQ2_feed" lib="Step" parFile="HVDC_TwoAreasRegulated_PropagatingEvent.par" parId="Zero"/>

  <!-- ============== Generator connects ============== -->
  <dyn:connect id1="GEN_A1" var1="generator_terminal" id2="NETWORK" var2="A_HV1_ACPIN"/>
  <dyn:connect id1="GEN_A1" var1="generator_switchOffSignal1" id2="NETWORK" var2="A_HV1_switchOff"/>
  <dyn:connect id1="GEN_A2" var1="generator_terminal" id2="NETWORK" var2="A_HV2_ACPIN"/>
  <dyn:connect id1="GEN_A2" var1="generator_switchOffSignal1" id2="NETWORK" var2="A_HV2_switchOff"/>
  <dyn:connect id1="GEN_B1" var1="generator_terminal" id2="NETWORK" var2="B_HV1_ACPIN"/>
  <dyn:connect id1="GEN_B1" var1="generator_switchOffSignal1" id2="NETWORK" var2="B_HV1_switchOff"/>
  <dyn:connect id1="GEN_B2" var1="generator_terminal" id2="NETWORK" var2="B_HV2_ACPIN"/>
  <dyn:connect id1="GEN_B2" var1="generator_switchOffSignal1" id2="NETWORK" var2="B_HV2_switchOff"/>

  <!-- ============== Load connects ============== -->
  <dyn:connect id1="LOAD_A1" var1="load_terminal" id2="NETWORK" var2="A_LD1_ACPIN"/>
  <dyn:connect id1="LOAD_A2" var1="load_terminal" id2="NETWORK" var2="A_LD2_ACPIN"/>
  <dyn:connect id1="LOAD_A3" var1="load_terminal" id2="NETWORK" var2="A_LD3_ACPIN"/>
  <dyn:connect id1="LOAD_B1" var1="load_terminal" id2="NETWORK" var2="B_LD1_ACPIN"/>
  <dyn:connect id1="LOAD_B2" var1="load_terminal" id2="NETWORK" var2="B_LD2_ACPIN"/>
  <dyn:connect id1="LOAD_B3" var1="load_terminal" id2="NETWORK" var2="B_LD3_ACPIN"/>

  <!-- ============== OmegaRef wiring (one frequency barycenter per AC area) ============== -->
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_0_value"    id2="GEN_A1" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_0_value" id2="GEN_A1" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_0"          id2="NETWORK" var2="A_HV1_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_0"         id2="GEN_A1" var2="generator_running"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_1_value"    id2="GEN_A2" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_1_value" id2="GEN_A2" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_1"          id2="NETWORK" var2="A_HV2_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_1"         id2="GEN_A2" var2="generator_running"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_2_value"    id2="GEN_B1" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_2_value" id2="GEN_B1" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_2"          id2="NETWORK" var2="B_HV1_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_2"         id2="GEN_B1" var2="generator_running"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_3_value"    id2="GEN_B2" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_3_value" id2="GEN_B2" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_3"          id2="NETWORK" var2="B_HV2_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_3"         id2="GEN_B2" var2="generator_running"/>

  <!-- ============== Event ============== -->
  <!-- ============== Load-step event: drives LOAD_A1's PRefPu ============== -->
  <dyn:connect id1="StepP_A1" var1="step_step" id2="LOAD_A1" var2="load_PRefPu"/>

  <!-- ============== HVDC voltage-droop signals tied to zero (modeU=false) ============== -->
  <dyn:connect id1="NQ1_feed" var1="step_step" id2="HVDC1" var2="hvdc_NQ1"/>
  <dyn:connect id1="NQ2_feed" var1="step_step" id2="HVDC1" var2="hvdc_NQ2"/>

  <!-- ============== Explicit HVDC1 AC terminal connections ============== -->
  <dyn:connect id1="HVDC1" var1="hvdc_terminal1" id2="NETWORK" var2="A_HV1_ACPIN"/>
  <dyn:connect id1="HVDC1" var1="hvdc_terminal2" id2="NETWORK" var2="B_HV1_ACPIN"/>

</dyn:dynamicModelsArchitecture>
