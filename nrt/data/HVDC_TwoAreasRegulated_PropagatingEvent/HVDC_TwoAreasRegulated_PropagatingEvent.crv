<curvesInput xmlns="http://www.rte-france.com/dynawo">
  <!-- Generator dynamics -->
  <curve model="GEN_A1" variable="generator_omegaPu"/>
  <curve model="GEN_A1" variable="generator_PGen"/>
  <curve model="GEN_A1" variable="generator_QGen"/>
  <curve model="GEN_A1" variable="generator_UStatorPu"/>
  <curve model="GEN_A1" variable="voltageRegulator_EfdPu"/>
  <curve model="GEN_A2" variable="generator_omegaPu"/>
  <curve model="GEN_A2" variable="generator_PGen"/>
  <curve model="GEN_A2" variable="generator_QGen"/>
  <curve model="GEN_A2" variable="generator_UStatorPu"/>
  <curve model="GEN_B1" variable="generator_omegaPu"/>
  <curve model="GEN_B1" variable="generator_PGen"/>
  <curve model="GEN_B1" variable="generator_QGen"/>
  <curve model="GEN_B1" variable="generator_UStatorPu"/>
  <curve model="GEN_B1" variable="voltageRegulator_EfdPu"/>
  <curve model="GEN_B2" variable="generator_omegaPu"/>
  <curve model="GEN_B2" variable="generator_PGen"/>
  <curve model="GEN_B2" variable="generator_QGen"/>
  <curve model="GEN_B2" variable="generator_UStatorPu"/>
  <!-- One omegaRef barycenter per AC area -->
  <curve model="OMEGA_REF" variable="omegaRef_0_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_1_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_grp_0_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_grp_2_value"/>
  <!-- Transmission bus voltages -->
  <curve model="NETWORK" variable="A_HV1_Upu_value"/>
  <curve model="NETWORK" variable="A_HV2_Upu_value"/>
  <curve model="NETWORK" variable="A_HV3_Upu_value"/>
  <curve model="NETWORK" variable="B_HV1_Upu_value"/>
  <curve model="NETWORK" variable="B_HV2_Upu_value"/>
  <!-- A few distribution bus voltages -->
  <curve model="NETWORK" variable="A_LD1_Upu_value"/>
  <curve model="NETWORK" variable="B_LD2_Upu_value"/>
  <!-- numcc on a bus in each area -->
  <curve model="NETWORK" variable="A_HV1_numcc_value"/>
  <curve model="NETWORK" variable="B_HV1_numcc_value"/>
  <curve model="HVDC1" variable="hvdc_PInj1Pu"/>
  <curve model="HVDC1" variable="hvdc_PInj2Pu"/>
  <curve model="HVDC1" variable="hvdc_P1RefPu"/>
  <curve model="LOAD_A1" variable="load_PPu"/>
</curvesInput>
