    SPDX-License-Identifier: MPL-2.0

    This file is part of Dynawo, a hybrid C++/Modelica open source time domain
    simulation tool for power systems.

    Consistent island load flow (base SnRef = 100 MVA, line R = 0, X = 0.1):
      machine bus A: U = 1.05 pu, angle = 0.0762 rad
      load bus B:    U = 1.00 pu, angle = 0.0    rad
      line current A->B = 0.799326 - j 0.469536 pu
      total machine injection at A = 0.799324 + j 0.555475 pu (split G1 + G2)
      load consumption at B        = 0.799326 + j 0.469536 pu
    No disturbance is applied: a correctly initialized model stays at this point.
-->
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- Machine G1 (Xd = 2.0, strong saturation) -->
  <set id="G1">
    <par type="DOUBLE" name="generator_H" value="4.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.003"/>
    <par type="DOUBLE" name="generator_XdPu" value="2.0"/>
    <par type="DOUBLE" name="generator_XpdPu" value="0.3"/>
    <par type="DOUBLE" name="generator_XppdPu" value="0.22"/>
    <par type="DOUBLE" name="generator_XqPu" value="1.9"/>
    <par type="DOUBLE" name="generator_XpqPu" value="0.5"/>
    <par type="DOUBLE" name="generator_XppqPu" value="0.22"/>
    <par type="DOUBLE" name="generator_XlPu" value="0.15"/>
    <par type="DOUBLE" name="generator_Tpd0" value="7.0"/>
    <par type="DOUBLE" name="generator_Tppd0" value="0.05"/>
    <par type="DOUBLE" name="generator_Tpq0" value="0.7"/>
    <par type="DOUBLE" name="generator_Tppq0" value="0.1"/>
    <par type="DOUBLE" name="generator_Se1Pu" value="0.1"/>
    <par type="DOUBLE" name="generator_Se12Pu" value="0.3"/>
    <par type="DOUBLE" name="generator_SNom" value="100.0"/>
    <par type="DOUBLE" name="generator_P0Pu" value="-0.5"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="-0.35"/>
    <par type="DOUBLE" name="generator_U0Pu" value="1.05"/>
    <par type="DOUBLE" name="generator_UPhase0" value="0.0762"/>
  </set>
  <!-- Machine G2 (Xd = 1.81, milder saturation, different time constants) -->
  <set id="G2">
    <par type="DOUBLE" name="generator_H" value="5.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.003"/>
    <par type="DOUBLE" name="generator_XdPu" value="1.81"/>
    <par type="DOUBLE" name="generator_XpdPu" value="0.3"/>
    <par type="DOUBLE" name="generator_XppdPu" value="0.23"/>
    <par type="DOUBLE" name="generator_XqPu" value="1.76"/>
    <par type="DOUBLE" name="generator_XpqPu" value="0.65"/>
    <par type="DOUBLE" name="generator_XppqPu" value="0.25"/>
    <par type="DOUBLE" name="generator_XlPu" value="0.15"/>
    <par type="DOUBLE" name="generator_Tpd0" value="8.0"/>
    <par type="DOUBLE" name="generator_Tppd0" value="0.03"/>
    <par type="DOUBLE" name="generator_Tpq0" value="1.0"/>
    <par type="DOUBLE" name="generator_Tppq0" value="0.07"/>
    <par type="DOUBLE" name="generator_Se1Pu" value="0.05"/>
    <par type="DOUBLE" name="generator_Se12Pu" value="0.2"/>
    <par type="DOUBLE" name="generator_SNom" value="100.0"/>
    <par type="DOUBLE" name="generator_P0Pu" value="-0.299324"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="-0.205475"/>
    <par type="DOUBLE" name="generator_U0Pu" value="1.05"/>
    <par type="DOUBLE" name="generator_UPhase0" value="0.0762"/>
  </set>
  <set id="LINE">
    <par type="DOUBLE" name="line_RPu" value="0.0"/>
    <par type="DOUBLE" name="line_XPu" value="0.1"/>
    <par type="DOUBLE" name="line_BPu" value="0.0"/>
    <par type="DOUBLE" name="line_GPu" value="0.0"/>
  </set>
  <set id="LOAD">
    <par type="DOUBLE" name="load_alpha" value="2.0"/>
    <par type="DOUBLE" name="load_beta" value="2.0"/>
    <par type="DOUBLE" name="load_P0Pu" value="0.799326"/>
    <par type="DOUBLE" name="load_Q0Pu" value="0.469536"/>
    <par type="DOUBLE" name="load_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="load_UPhase0" value="0.0"/>
  </set>
  <set id="OMEGAREF">
    <par type="DOUBLE" name="setPoint_Value0" value="1.0"/>
  </set>
</parametersSet>
