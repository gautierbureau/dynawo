<?xml version='1.0' encoding='UTF-8'?>
<jobs xmlns="http://www.rte-france.com/dynawo">
  <job name="tapreg">
    <solver lib="dynawo_SolverTRAP" parFile="tapreg.par" parId="Solver"/>
    <modeler compileDir="outputs/compilation">
      <network iidmFile="tap.iidm" parFile="tapreg.par" parId="Network" lib="DYNModelNetworkEMT"/>
      <dynModels dydFile="tapreg.dyd"/>
      <precompiledModels useStandardModels="true"/>
      <modelicaModels useStandardModels="true"/>
    </modeler>
    <simulation startTime="0" stopTime="0.4"/>
    <outputs directory="outputs">
      <curves inputFile="tap.crv" exportMode="CSV"/>

    </outputs>
  </job>
</jobs>
