<?xml version="1.0" encoding="UTF-8"?>
<iidm:network xmlns:iidm="http://www.powsybl.org/schema/iidm/1_4" id="emtsmib" caseDate="2024-01-01T00:00:00.000+00:00" forecastDistance="0" sourceFormat="manual">
  <!-- SMIB: detailed EMT machine (black box at B0) -> line -> infinite bus (B1).
       The IIDM carries a CONSISTENT load flow so the case flat-starts:
       B0 = 1.0/_0deg (machine terminal, matches machine_U0Pu/UPhase0),
       B1 = 0.97834/_-4.557deg (= V0 - I*Zline with I = 0.495/_0 the machine output),
       so the line current initializes to exactly the machine's 0.495 pu and di/dt = 0. -->
  <iidm:substation id="S0" country="FR">
    <iidm:voltageLevel id="VL0" nominalV="1.0" topologyKind="BUS_BREAKER">
      <iidm:busBreakerTopology>
        <iidm:bus id="B0" v="1.0" angle="0.0"/>
      </iidm:busBreakerTopology>
      <iidm:generator id="G0" energySource="OTHER" minP="-999.0" maxP="999.0" voltageRegulatorOn="true" targetP="0.0" targetV="1.0" targetQ="0.0" bus="B0" connectableBus="B0" p="0.0" q="0.0">
        <iidm:minMaxReactiveLimits minQ="-999.0" maxQ="999.0"/>
      </iidm:generator>
    </iidm:voltageLevel>
  </iidm:substation>
  <iidm:substation id="S1" country="FR">
    <iidm:voltageLevel id="VL1" nominalV="1.0" topologyKind="BUS_BREAKER">
      <iidm:busBreakerTopology>
        <iidm:bus id="B1" v="0.97834" angle="-4.557"/>
      </iidm:busBreakerTopology>
      <iidm:generator id="INFBUS" energySource="OTHER" minP="-999.0" maxP="999.0" voltageRegulatorOn="true" targetP="0.0" targetV="0.97834" targetQ="0.0" bus="B1" connectableBus="B1" p="0.0" q="0.0">
        <iidm:minMaxReactiveLimits minQ="-999.0" maxQ="999.0"/>
      </iidm:generator>
    </iidm:voltageLevel>
  </iidm:substation>
  <iidm:line id="LINE" r="0.0005" x="0.0015707963267948967" g1="0.0" b1="0.0" g2="0.0" b2="0.0" bus1="B0" connectableBus1="B0" voltageLevelId1="VL0" bus2="B1" connectableBus2="B1" voltageLevelId2="VL1" p1="0.0" q1="0.0" p2="0.0" q2="0.0"/>
</iidm:network>
