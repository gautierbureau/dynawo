<?xml version='1.0' encoding='UTF-8'?>
<jobs xmlns="http://www.rte-france.com/dynawo">
  <job name="smibnetflt">
    <solver lib="dynawo_SolverTRAP" parFile="smibnetflt.par" parId="Solver"/>
    <modeler compileDir="outputs/compilation">
      <network iidmFile="smibnet.iidm" parFile="smibnetflt.par" parId="Network" lib="DYNModelNetworkEMT"/>
      <dynModels dydFile="smibnet.dyd"/>
      <precompiledModels useStandardModels="true"/>
      <modelicaModels useStandardModels="true"/>
    </modeler>
    <simulation startTime="0" stopTime="0.5"/>
    <outputs directory="outputs">
      <curves inputFile="smibnetflt.crv" exportMode="CSV"/>
      <logs><appender tag="" file="dynawo.log" lvlFilter="INFO"/></logs>
    </outputs>
  </job>
</jobs>
