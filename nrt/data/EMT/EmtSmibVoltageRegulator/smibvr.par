<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="MACHINE">
    <par type="DOUBLE" name="generator_P0Pu" value="-0.602"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="-0.024"/>
    <par type="DOUBLE" name="generator_U0Pu" value="0.9142993715318843"/>
    <par type="DOUBLE" name="generator_UPhase0" value="-0.071687"/>
    <par type="DOUBLE" name="generator_SNom" value="100"/>
    <par type="DOUBLE" name="generator_UNom" value="1"/>
    <par type="DOUBLE" name="generator_PNomTurb" value="90"/>
    <par type="DOUBLE" name="generator_PNomAlt" value="90"/>
    <par type="INT"    name="generator_ExcitationPu" value="1"/>
    <par type="DOUBLE" name="generator_H" value="3.5"/>
    <par type="DOUBLE" name="generator_DPu" value="0"/>
    <par type="DOUBLE" name="generator_SnTfo" value="100"/>
    <par type="DOUBLE" name="generator_UNomHV" value="1"/>
    <par type="DOUBLE" name="generator_UNomLV" value="1"/>
    <par type="DOUBLE" name="generator_UBaseHV" value="1"/>
    <par type="DOUBLE" name="generator_UBaseLV" value="1"/>
    <par type="DOUBLE" name="generator_RTfPu" value="0"/>
    <par type="DOUBLE" name="generator_XTfPu" value="0"/>
    <par type="DOUBLE" name="generator_md" value="0.1"/>
    <par type="DOUBLE" name="generator_mq" value="0.1"/>
    <par type="DOUBLE" name="generator_nd" value="2"/>
    <par type="DOUBLE" name="generator_nq" value="2"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.003"/>
    <par type="DOUBLE" name="generator_LdPu" value="0.15"/>
    <par type="DOUBLE" name="generator_MdPu" value="1.66"/>
    <par type="DOUBLE" name="generator_LDPu" value="0.16"/>
    <par type="DOUBLE" name="generator_RDPu" value="0.03"/>
    <par type="DOUBLE" name="generator_MrcPu" value="0"/>
    <par type="DOUBLE" name="generator_LfPu" value="0.165"/>
    <par type="DOUBLE" name="generator_RfPu" value="0.0006"/>
    <par type="DOUBLE" name="generator_LqPu" value="0.15"/>
    <par type="DOUBLE" name="generator_MqPu" value="1.61"/>
    <par type="DOUBLE" name="generator_LQ1Pu" value="0.07"/>
    <par type="DOUBLE" name="generator_RQ1Pu" value="0.0062"/>
    <par type="DOUBLE" name="generator_LQ2Pu" value="0.21"/>
    <par type="DOUBLE" name="generator_RQ2Pu" value="0.024"/>
    <par type="DOUBLE" name="generator_MdPuEfd" value="0"/>
    <par type="DOUBLE" name="governor_PNom" value="90"/>
    <par type="DOUBLE" name="governor_PMin" value="0"/>
    <par type="DOUBLE" name="governor_PMax" value="90"/>
    <par type="DOUBLE" name="governor_KGover" value="5"/>
    <par type="DOUBLE" name="voltageRegulator_Gain" value="20"/>
    <par type="DOUBLE" name="voltageRegulator_EfdMinPu" value="-5"/>
    <par type="DOUBLE" name="voltageRegulator_EfdMaxPu" value="5"/>
    <par type="DOUBLE" name="voltageRegulator_UsRefMinPu" value="0.8"/>
    <par type="DOUBLE" name="voltageRegulator_UsRefMaxPu" value="1.2"/>
    <par type="DOUBLE" name="voltageRegulator_LagEfdMin" value="0"/>
    <par type="DOUBLE" name="voltageRegulator_LagEfdMax" value="0"/>
  </set>
  <set id="CAPGEN">
    <par type="DOUBLE" name="cap_CPu" value="1e-4"/>
    <par type="DOUBLE" name="cap_UMagPu" value="1.293015"/>
    <par type="DOUBLE" name="cap_UPhaseRad" value="-0.071687"/>
  </set>
  <set id="CAPBUS">
    <par type="DOUBLE" name="cap_CPu" value="1e-4"/>
    <par type="DOUBLE" name="cap_UMagPu" value="1.295220"/>
    <par type="DOUBLE" name="cap_UPhaseRad" value="-0.144485"/>
  </set>
  <set id="DAMP"><par type="DOUBLE" name="resistor_RPu" value="100"/></set>
  <set id="TFO">
    <par type="DOUBLE" name="tfo_rTfoPu" value="1.0"/>
    <par type="DOUBLE" name="tfo_RPu" value="0.0"/>
    <par type="DOUBLE" name="tfo_LPu" value="3.183e-4"/>
    <par type="DOUBLE" name="tfo_FNom" value="50"/>
    <par type="DOUBLE" name="tfo_UpMagPu" value="1.293015"/>
    <par type="DOUBLE" name="tfo_UpPhaseRad" value="-0.071687"/>
    <par type="DOUBLE" name="tfo_UsMagPu" value="1.295220"/>
    <par type="DOUBLE" name="tfo_UsPhaseRad" value="-0.144485"/>
  </set>
  <set id="LINE">
    <par type="DOUBLE" name="line_RPu" value="0.02"/>
    <par type="DOUBLE" name="line_LPu" value="6.366e-4"/>
    <par type="DOUBLE" name="line_FNom" value="50"/>
    <par type="DOUBLE" name="line_UpMagPu" value="1.295220"/>
    <par type="DOUBLE" name="line_UpPhaseRad" value="-0.144485"/>
    <par type="DOUBLE" name="line_UnMagPu" value="1.293209"/>
    <par type="DOUBLE" name="line_UnPhaseRad" value="-0.288668"/>
  </set>
  <set id="FAULT">
    <par type="DOUBLE" name="fault_RfPu" value="0.005"/>
    <par type="DOUBLE" name="fault_tBegin" value="0.4"/>
    <par type="DOUBLE" name="fault_tEnd" value="0.5"/>
    <par type="BOOL" name="fault_faultedPhase_0_" value="true"/>
    <par type="BOOL" name="fault_faultedPhase_1_" value="true"/>
    <par type="BOOL" name="fault_faultedPhase_2_" value="true"/>
  </set>
  <set id="INFBUS">
    <par type="DOUBLE" name="source_UPeakPu" value="1.293209"/>
    <par type="DOUBLE" name="source_FNom" value="50"/>
    <par type="DOUBLE" name="source_Phase0" value="-0.288668"/>
  </set>
  <set id="OMEGAREF"><par type="DOUBLE" name="setPoint_Value0" value="1"/></set>
  <set id="Solver">
    <par type="DOUBLE" name="hMin" value="2e-5"/>
    <par type="DOUBLE" name="hMax" value="2e-5"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="STRING" name="linearSolverName" value="KLU"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="100"/>
  </set>
</parametersSet>
