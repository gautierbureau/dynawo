<?xml version='1.0' encoding='UTF-8'?>
<jobs xmlns="http://www.rte-france.com/dynawo">
  <job name="smib_iidm">
    <solver lib="dynawo_SolverTRAP" parFile="smib_iidm.par" parId="Solver"/>
    <modeler compileDir="outputs/compilation">
      <network iidmFile="smib_dynawo.xiidm" parFile="smib_iidm.par" parId="Network"/>
      <dynModels dydFile="smib_iidm.dyd"/>
      <precompiledModels useStandardModels="true"/>
      <modelicaModels useStandardModels="true"/>
    </modeler>
    <simulation startTime="0" stopTime="0.3"/>
    <outputs directory="outputs">
      <curves inputFile="smib_iidm.crv" exportMode="CSV"/>
      <logs><appender tag="" file="dynawo.log" lvlFilter="INFO"/></logs>
    </outputs>
  </job>
</jobs>
