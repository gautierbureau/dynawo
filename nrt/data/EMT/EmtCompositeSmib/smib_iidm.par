<?xml version='1.0' encoding='UTF-8'?>
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="MACHINE">
    <reference name="machine_P0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="machine_Q0Pu" origData="IIDM" origName="q_pu" type="DOUBLE"/>
    <reference name="machine_U0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <reference name="machine_UPhase0" origData="IIDM" origName="angle_pu" type="DOUBLE"/>
  </set>
  <set id="BUSGEN">
    <par type="DOUBLE" name="bus_CPu" value="1e-4"/>
    <reference name="bus_UMag0Pu" origData="IIDM" origName="Upu" type="DOUBLE"/>
    <reference name="bus_UPhase0" origData="IIDM" origName="Theta_pu" type="DOUBLE"/>
  </set>
  <set id="BUSHV">
    <par type="DOUBLE" name="bus_CPu" value="1e-4"/>
    <reference name="bus_UMag0Pu" origData="IIDM" origName="Upu" type="DOUBLE"/>
    <reference name="bus_UPhase0" origData="IIDM" origName="Theta_pu" type="DOUBLE"/>
  </set>
  <set id="TFO">
    <par type="DOUBLE" name="tfo_rTfoPu" value="1.0"/>
    <reference name="tfo_RPu" origData="IIDM" origName="r_pu" type="DOUBLE"/>
    <reference name="tfo_XPu" origData="IIDM" origName="x_pu" type="DOUBLE"/>
    <par type="DOUBLE" name="tfo_UpMagPu" value="1.301076"/>
    <par type="DOUBLE" name="tfo_UpPhaseRad" value="0.217013"/>
    <par type="DOUBLE" name="tfo_UsMagPu" value="1.291145"/>
    <par type="DOUBLE" name="tfo_UsPhaseRad" value="0.145517"/>
  </set>
  <set id="LINE">
    <reference name="line_RPu" origData="IIDM" origName="r_pu" type="DOUBLE"/>
    <reference name="line_XPu" origData="IIDM" origName="x_pu" type="DOUBLE"/>
    <par type="DOUBLE" name="line_UpMagPu" value="1.291145"/>
    <par type="DOUBLE" name="line_UpPhaseRad" value="0.145517"/>
    <par type="DOUBLE" name="line_UnMagPu" value="1.272792"/>
    <par type="DOUBLE" name="line_UnPhaseRad" value="0.0"/>
  </set>
  <set id="INFBUS">
    <par type="DOUBLE" name="source_UPeakPu" value="1.272792206"/>
    <par type="DOUBLE" name="source_FNom" value="50"/>
    <par type="DOUBLE" name="source_Phase0" value="0.0"/>
  </set>
  <set id="Network">
    <par type="DOUBLE" name="capacitor_no_reclosing_delay" value="300"/>
    <par type="DOUBLE" name="load_alpha" value="1"/>
    <par type="DOUBLE" name="load_alphaLong" value="0"/>
    <par type="DOUBLE" name="load_beta" value="1"/>
    <par type="DOUBLE" name="load_betaLong" value="0"/>
    <par type="BOOL" name="load_isControllable" value="false"/>
    <par type="BOOL" name="load_isRestorative" value="false"/>
    <par type="DOUBLE" name="load_Tp" value="90"/>
    <par type="DOUBLE" name="load_Tq" value="90"/>
    <par type="DOUBLE" name="load_zPMax" value="100"/>
    <par type="DOUBLE" name="load_zQMax" value="100"/>
    <par type="DOUBLE" name="line_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="transformer_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="transformer_t1st_HT" value="60"/>
    <par type="DOUBLE" name="transformer_t1st_THT" value="30"/>
    <par type="DOUBLE" name="transformer_tNext_HT" value="10"/>
    <par type="DOUBLE" name="transformer_tNext_THT" value="10"/>
    <par type="DOUBLE" name="transformer_tolV" value="0.015"/>
    <par type="DOUBLE" name="reactance_no_reclosing_delay" value="0"/>
    <par type="DOUBLE" name="dangling_line_currentLimit_maxTimeOperation" value="90"/>
  </set>
  <set id="Solver">
    <par type="DOUBLE" name="hMin" value="2e-5"/>
    <par type="DOUBLE" name="hMax" value="2e-5"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="STRING" name="linearSolverName" value="KLU"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="100"/>
  </set>
</parametersSet>
