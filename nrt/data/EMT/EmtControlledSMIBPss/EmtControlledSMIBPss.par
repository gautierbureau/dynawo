<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="GEN">
    <par type="DOUBLE" name="generator_P0Pu" value="-0.602"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="-0.024"/>
    <par type="DOUBLE" name="generator_U0Pu" value="0.9142993715318843"/>
    <par type="DOUBLE" name="generator_UPhase0" value="-0.071687"/>
    <!-- High-gain fast AVR: deliberately erodes the damping of the local
         electromechanical mode so the power system stabilizer has something
         to damp (the textbook negative-damping-from-fast-excitation setup). -->
    <par type="DOUBLE" name="voltageRegulator_Gain" value="100"/>
    <par type="DOUBLE" name="voltageRegulator_tIntegral" value="0.5"/>
    <par type="DOUBLE" name="voltageRegulator_EfdMaxPu" value="6"/>
    <par type="DOUBLE" name="voltageRegulator_EfdMinPu" value="0"/>
    <par type="DOUBLE" name="voltageRegulator_LagEfdMax" value="0"/>
    <par type="DOUBLE" name="voltageRegulator_LagEfdMin" value="0"/>
    <par type="DOUBLE" name="voltageRegulator_UsRefMaxPu" value="2"/>
    <par type="DOUBLE" name="voltageRegulator_UsRefMinPu" value="0"/>
    <par type="DOUBLE" name="governor_KGover" value="20"/>
    <par type="DOUBLE" name="governor_PNom" value="1"/>
    <par type="DOUBLE" name="governor_PMax" value="1.2"/>
    <par type="DOUBLE" name="governor_PMin" value="-0.2"/>
    <!-- Speed-input PSS (reused phasor Pss1aOmega), tuned for the ~1.25 Hz
         local mode: two identical lead-lag stages (0.12 s lead / 0.02 s lag,
         ~+72 deg) compensate the exciter+field phase lag; Ks = 4 sets the
         damping gain; t5 = 3 s washout removes the steady speed bias; the
         +/-0.1 pu output limits keep the stabilizer signal modest. -->
    <par type="DOUBLE" name="pss_Ks" value="4"/>
    <par type="DOUBLE" name="pss_t1" value="0.12"/>
    <par type="DOUBLE" name="pss_t2" value="0.02"/>
    <par type="DOUBLE" name="pss_t3" value="0.12"/>
    <par type="DOUBLE" name="pss_t4" value="0.02"/>
    <par type="DOUBLE" name="pss_t5" value="3.0"/>
    <par type="DOUBLE" name="pss_t6" value="0.02"/>
    <par type="DOUBLE" name="pss_A1" value="0.0"/>
    <par type="DOUBLE" name="pss_A2" value="0.0"/>
    <par type="DOUBLE" name="pss_VPssMaxPu" value="0.1"/>
    <par type="DOUBLE" name="pss_VPssMinPu" value="-0.1"/>
  </set>
  <set id="CAPGEN">
    <par type="DOUBLE" name="cap_CPu" value="1e-4"/>
    <par type="DOUBLE" name="cap_U0Pu_0_" value="1.28967904228"/>
    <par type="DOUBLE" name="cap_U0Pu_1_" value="-0.725043797339"/>
    <par type="DOUBLE" name="cap_U0Pu_2_" value="-0.564635244945"/>
  </set>
  <set id="CAPBUS">
    <par type="DOUBLE" name="cap_CPu" value="1e-4"/>
    <par type="DOUBLE" name="cap_U0Pu_0_" value="1.28226280196"/>
    <par type="DOUBLE" name="cap_U0Pu_1_" value="-0.746700727495"/>
    <par type="DOUBLE" name="cap_U0Pu_2_" value="-0.535562074465"/>
  </set>
  <set id="DAMP"><par type="DOUBLE" name="resistor_RPu" value="100"/></set>
  <set id="TFO">
    <par type="DOUBLE" name="tfo_rTfoPu" value="1.0"/>
    <par type="DOUBLE" name="tfo_RPu" value="0.0"/>
    <par type="DOUBLE" name="tfo_LPu" value="3.183e-4"/>
    <par type="DOUBLE" name="tfo_I0Pu_0_" value="0.292899469558"/>
    <par type="DOUBLE" name="tfo_I0Pu_1_" value="-0.210678254821"/>
    <par type="DOUBLE" name="tfo_I0Pu_2_" value="-0.0822212147376"/>
  </set>
  <set id="LINE">
    <par type="DOUBLE" name="line_RPu" value="0.02"/>
    <par type="DOUBLE" name="line_LPu" value="6.366e-4"/>
    <par type="DOUBLE" name="line_I0Pu_0_" value="0.276247209992"/>
    <par type="DOUBLE" name="line_I0Pu_1_" value="-0.236182943597"/>
    <par type="DOUBLE" name="line_I0Pu_2_" value="-0.0400642663951"/>
  </set>
  <set id="FAULT">
    <!-- Mild balanced three-phase-to-ground fault (high fault resistance): a
         gentle, symmetric nudge that excites the electromechanical mode while
         keeping the rotor swing in the linear regime and the speed signal
         ripple-free. -->
    <par type="DOUBLE" name="fault_RfPu" value="0.5"/>
    <par type="DOUBLE" name="fault_tBegin" value="0.4"/>
    <par type="DOUBLE" name="fault_tEnd" value="0.45"/>
    <par type="BOOL" name="fault_faultedPhase_0_" value="true"/>
    <par type="BOOL" name="fault_faultedPhase_1_" value="true"/>
    <par type="BOOL" name="fault_faultedPhase_2_" value="true"/>
  </set>
  <set id="INFBUS">
    <par type="DOUBLE" name="source_UPeakPu" value="1.26622786904"/>
    <par type="DOUBLE" name="source_FNom" value="50"/>
    <par type="DOUBLE" name="source_Phase0" value="-0.138557154077"/>
  </set>
  <set id="Solver">
    <par type="DOUBLE" name="hMin" value="2e-5"/>
    <par type="DOUBLE" name="hMax" value="2e-5"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="STRING" name="linearSolverName" value="KLU"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="100"/>
  </set>
</parametersSet>
