<?xml version='1.0' encoding='UTF-8'?>
<jobs xmlns="http://www.rte-france.com/dynawo">
  <job name="svc">
    <solver lib="dynawo_SolverTRAP" parFile="svc.par" parId="Solver"/>
    <modeler compileDir="outputs/compilation">
      <network iidmFile="svc.iidm" parFile="svc.par" parId="Network" lib="DYNModelNetworkEMT"/>
      <dynModels dydFile="svc.dyd"/>
      <precompiledModels useStandardModels="true"/>
      <modelicaModels useStandardModels="true"/>
    </modeler>
    <simulation startTime="0" stopTime="0.06"/>
    <outputs directory="outputs">
      <curves inputFile="svc.crv" exportMode="CSV"/>

    </outputs>
  </job>
</jobs>
