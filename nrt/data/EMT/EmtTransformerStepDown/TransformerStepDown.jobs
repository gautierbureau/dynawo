<?xml version='1.0' encoding='UTF-8'?>
<jobs xmlns="http://www.rte-france.com/dynawo">
    <job name="TransformerStepDown">
        <solver lib="dynawo_SolverTRAP" parFile="TransformerStepDown.par" parId="Solver"/>
        <modeler compileDir="outputs/compilation">
            <dynModels dydFile="TransformerStepDown.dyd"/>
            <precompiledModels useStandardModels="true"/>
            <modelicaModels useStandardModels="true"/>
        </modeler>
        <simulation startTime="0" stopTime="0.1"/>
        <outputs directory="outputs">
            <curves inputFile="TransformerStepDown.crv" exportMode="CSV"/>
            <logs><appender tag="" file="dynawo.log" lvlFilter="INFO"/></logs>
        </outputs>
    </job>
</jobs>
