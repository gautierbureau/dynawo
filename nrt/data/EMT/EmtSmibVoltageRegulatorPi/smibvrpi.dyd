<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="MACHINE" lib="GeneratorEmtSynchronousFullGoverPropVRPropInt" parFile="smibvrpi.par" parId="MACHINE"/>
  <dyn:blackBoxModel id="CAPGEN"  lib="EmtCapacitor"          parFile="smibvrpi.par" parId="CAPGEN"/>
  <dyn:blackBoxModel id="DAMPGEN" lib="EmtResistor"           parFile="smibvrpi.par" parId="DAMP"/>
  <dyn:blackBoxModel id="TFO"     lib="EmtTransformerYgYg"     parFile="smibvrpi.par" parId="TFO"/>
  <dyn:blackBoxModel id="CAPBUS"  lib="EmtCapacitor"          parFile="smibvrpi.par" parId="CAPBUS"/>
  <dyn:blackBoxModel id="DAMPBUS" lib="EmtResistor"           parFile="smibvrpi.par" parId="DAMP"/>
  <dyn:blackBoxModel id="FAULT"   lib="EmtFault"              parFile="smibvrpi.par" parId="FAULT"/>
  <dyn:blackBoxModel id="LINE"    lib="EmtSeriesRL"           parFile="smibvrpi.par" parId="LINE"/>
  <dyn:blackBoxModel id="INFBUS"  lib="EmtVoltageSource"       parFile="smibvrpi.par" parId="INFBUS"/>
  <dyn:blackBoxModel id="GGEN" lib="EmtGround"/>
  <dyn:blackBoxModel id="GBUS" lib="EmtGround"/>
  <dyn:blackBoxModel id="GINF" lib="EmtGround"/>
  <dyn:connect id1="MACHINE" var1="generator_terminal" id2="CAPGEN"  var2="cap_p"/>
  <dyn:connect id1="MACHINE" var1="generator_terminal" id2="DAMPGEN" var2="resistor_p"/>
  <dyn:connect id1="MACHINE" var1="generator_terminal" id2="TFO"     var2="tfo_primary"/>
  <dyn:connect id1="CAPGEN"  var1="cap_n"            id2="GGEN"    var2="ground_terminal"/>
  <dyn:connect id1="DAMPGEN" var1="resistor_n"      id2="GGEN"    var2="ground_terminal"/>
  <dyn:connect id1="TFO"     var1="tfo_secondary"   id2="CAPBUS"  var2="cap_p"/>
  <dyn:connect id1="TFO"     var1="tfo_secondary"   id2="DAMPBUS" var2="resistor_p"/>
  <dyn:connect id1="TFO"     var1="tfo_secondary"   id2="FAULT"   var2="fault_terminal"/>
  <dyn:connect id1="TFO"     var1="tfo_secondary"   id2="LINE"    var2="line_p"/>
  <dyn:connect id1="CAPBUS"  var1="cap_n"           id2="GBUS"    var2="ground_terminal"/>
  <dyn:connect id1="DAMPBUS" var1="resistor_n"      id2="GBUS"    var2="ground_terminal"/>
  <dyn:connect id1="LINE"    var1="line_n"          id2="INFBUS"  var2="source_p"/>
  <dyn:connect id1="INFBUS"  var1="source_n"        id2="GINF"    var2="ground_terminal"/>
  <dyn:blackBoxModel id="OMEGAREF" lib="SetPoint" parFile="smibvrpi.par" parId="OMEGAREF"/>
  <dyn:connect id1="OMEGAREF" var1="setPoint_setPoint" id2="MACHINE" var2="generator_omegaRefPu"/>
</dyn:dynamicModelsArchitecture>
