<?xml version='1.0' encoding='UTF-8'?>
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="Network">
    <par type="DOUBLE" name="unused" value="0.0"/>
  </set>
  <set id="Solver">
    <par type="DOUBLE" name="hMin" value="1e-5"/>
    <par type="DOUBLE" name="hMax" value="1e-5"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="STRING" name="linearSolverName" value="KLU"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-7"/>
    <par type="INT" name="maximumNumberSlowStepIncrease" value="100"/>
  </set>
  <set id="INFBUS">
    <par type="DOUBLE" name="infiniteBus_UPu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="0.0"/>
    <par type="DOUBLE" name="infiniteBus_FNom" value="50"/>
  </set>
  <set id="LINEFLT">
    <par type="DOUBLE" name="line_RPu" value="0.05"/>
    <par type="DOUBLE" name="line_LPu" value="5.0e-4"/>
    <par type="DOUBLE" name="line_D" value="0.5"/>
    <par type="DOUBLE" name="line_RfPu" value="0.01"/>
    <par type="DOUBLE" name="line_tBegin" value="0.2"/>
    <par type="DOUBLE" name="line_tEnd" value="0.3"/>
    <par type="BOOL" name="line_faultedPhase_0_" value="true"/>
    <par type="BOOL" name="line_faultedPhase_1_" value="false"/>
    <par type="BOOL" name="line_faultedPhase_2_" value="false"/>
  </set>
</parametersSet>
