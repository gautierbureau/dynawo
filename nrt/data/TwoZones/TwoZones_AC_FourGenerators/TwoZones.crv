<curvesInput xmlns="http://www.rte-france.com/dynawo">
  <curve model="GEN1A" variable="generator_omegaPu"/>
  <curve model="GEN1A" variable="generator_PGenPu"/>
  <curve model="GEN1A" variable="generator_UPu"/>
  <curve model="GEN1B" variable="generator_omegaPu"/>
  <curve model="GEN1B" variable="generator_PGenPu"/>
  <curve model="GEN1B" variable="generator_UPu"/>
  <curve model="GEN2A" variable="generator_omegaPu"/>
  <curve model="GEN2A" variable="generator_PGenPu"/>
  <curve model="GEN2A" variable="generator_UPu"/>
  <curve model="GEN2B" variable="generator_omegaPu"/>
  <curve model="GEN2B" variable="generator_PGenPu"/>
  <curve model="GEN2B" variable="generator_UPu"/>
  <curve model="OMEGA_REF" variable="omegaRef_grp_0_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_grp_1_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_grp_2_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_grp_3_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_0_value"/>
  <curve model="OMEGA_REF" variable="omegaRef_1_value"/>
  <curve model="NETWORK" variable="GEN1A_BUS_numcc_value"/>
  <curve model="NETWORK" variable="GEN2A_BUS_numcc_value"/>
</curvesInput>
