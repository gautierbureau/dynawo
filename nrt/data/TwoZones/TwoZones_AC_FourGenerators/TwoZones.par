<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- GEN1A: heavy, well-damped machine in zone 1 -->
  <set id="1">
    <par type="DOUBLE" name="generator_H" value="6.5"/>
    <par type="DOUBLE" name="generator_DPu" value="2.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.0"/>
    <par type="DOUBLE" name="generator_XdPu" value="0.20"/>
    <reference name="generator_P0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="generator_Q0Pu" origData="IIDM" origName="q_pu" type="DOUBLE"/>
    <reference name="generator_U0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <reference name="generator_UPhase0" origData="IIDM" origName="angle_pu" type="DOUBLE"/>
  </set>
  <!-- GEN1B: lighter, lightly-damped machine in zone 1 -->
  <set id="2">
    <par type="DOUBLE" name="generator_H" value="4.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.5"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.0"/>
    <par type="DOUBLE" name="generator_XdPu" value="0.25"/>
    <reference name="generator_P0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="generator_Q0Pu" origData="IIDM" origName="q_pu" type="DOUBLE"/>
    <reference name="generator_U0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <reference name="generator_UPhase0" origData="IIDM" origName="angle_pu" type="DOUBLE"/>
  </set>
  <!-- GEN2A: mid-inertia, strongly-damped machine in zone 2 -->
  <set id="3">
    <par type="DOUBLE" name="generator_H" value="5.5"/>
    <par type="DOUBLE" name="generator_DPu" value="3.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.0"/>
    <par type="DOUBLE" name="generator_XdPu" value="0.18"/>
    <reference name="generator_P0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="generator_Q0Pu" origData="IIDM" origName="q_pu" type="DOUBLE"/>
    <reference name="generator_U0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <reference name="generator_UPhase0" origData="IIDM" origName="angle_pu" type="DOUBLE"/>
  </set>
  <!-- GEN2B: light, weakly-damped machine in zone 2 -->
  <set id="4">
    <par type="DOUBLE" name="generator_H" value="3.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.0"/>
    <par type="DOUBLE" name="generator_XdPu" value="0.30"/>
    <reference name="generator_P0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="generator_Q0Pu" origData="IIDM" origName="q_pu" type="DOUBLE"/>
    <reference name="generator_U0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <reference name="generator_UPhase0" origData="IIDM" origName="angle_pu" type="DOUBLE"/>
  </set>
  <!-- Loads LOAD1 and LOAD2 (start values read from the IIDM) -->
  <set id="5">
    <par type="DOUBLE" name="load_alpha" value="1.5"/>
    <par type="DOUBLE" name="load_beta" value="2.5"/>
    <reference name="load_P0Pu" origData="IIDM" origName="p_pu" type="DOUBLE"/>
    <reference name="load_Q0Pu" origData="IIDM" origName="q_pu" type="DOUBLE"/>
    <reference name="load_U0Pu" origData="IIDM" origName="v_pu" type="DOUBLE"/>
    <reference name="load_UPhase0" origData="IIDM" origName="angle_pu" type="DOUBLE"/>
  </set>
  <!-- Frequency handling: one barycenter per synchronous zone, weighted per machine -->
  <set id="6">
    <par type="INT" name="nbGen" value="4"/>
    <par type="DOUBLE" name="weight_gen_0" value="550"/>
    <par type="DOUBLE" name="weight_gen_1" value="400"/>
    <par type="DOUBLE" name="weight_gen_2" value="480"/>
    <par type="DOUBLE" name="weight_gen_3" value="450"/>
  </set>
  <!-- Network -->
  <set id="7">
    <par type="BOOL" name="keepAllSynchronousComponents" value="true"/>
    <par type="DOUBLE" name="capacitor_no_reclosing_delay" value="300"/>
    <par type="DOUBLE" name="dangling_line_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="line_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="load_Tp" value="90"/>
    <par type="DOUBLE" name="load_Tq" value="90"/>
    <par type="DOUBLE" name="load_alpha" value="1"/>
    <par type="DOUBLE" name="load_alphaLong" value="0"/>
    <par type="DOUBLE" name="load_beta" value="2"/>
    <par type="DOUBLE" name="load_betaLong" value="0"/>
    <par type="BOOL" name="load_isControllable" value="false"/>
    <par type="BOOL" name="load_isRestorative" value="false"/>
    <par type="DOUBLE" name="load_zPMax" value="100"/>
    <par type="DOUBLE" name="load_zQMax" value="100"/>
    <par type="DOUBLE" name="reactance_no_reclosing_delay" value="0"/>
    <par type="DOUBLE" name="transformer_currentLimit_maxTimeOperation" value="90"/>
    <par type="DOUBLE" name="transformer_t1st_HT" value="60"/>
    <par type="DOUBLE" name="transformer_t1st_THT" value="30"/>
    <par type="DOUBLE" name="transformer_tNext_HT" value="10"/>
    <par type="DOUBLE" name="transformer_tNext_THT" value="10"/>
    <par type="DOUBLE" name="transformer_tolV" value="0.014999999700000001"/>
  </set>
  <!-- Disconnection of the central line LINE_MID at t = 1 s (islanding) -->
  <set id="8">
    <par type="DOUBLE" name="event_tEvent" value="1.0"/>
    <par type="BOOL" name="event_disconnectOrigin" value="true"/>
    <par type="BOOL" name="event_disconnectExtremity" value="true"/>
  </set>
  <!-- Reconnection of the central line LINE_MID at t = 11 s (back to a single synchronous component) -->
  <set id="9">
    <par type="DOUBLE" name="event_tEvent" value="11.0"/>
    <par type="BOOL" name="event_connectOrigin" value="true"/>
    <par type="BOOL" name="event_connectExtremity" value="true"/>
  </set>
</parametersSet>
