<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="GEN1" lib="GeneratorClassical" parFile="TwoZones.par" parId="1" staticId="GEN1"/>
  <dyn:blackBoxModel id="GEN2" lib="GeneratorClassical" parFile="TwoZones.par" parId="1" staticId="GEN2"/>
  <dyn:blackBoxModel id="LOAD1" lib="LoadAlphaBeta" parFile="TwoZones.par" parId="2" staticId="LOAD1"/>
  <dyn:blackBoxModel id="LOAD2" lib="LoadAlphaBeta" parFile="TwoZones.par" parId="2" staticId="LOAD2"/>
  <dyn:blackBoxModel id="OMEGA_REF" lib="DYNModelOmegaRef" parFile="TwoZones.par" parId="3"/>
  <dyn:blackBoxModel id="fault" lib="NodeFault" parFile="TwoZones.par" parId="5"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_0_value" id2="GEN1" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_0_value" id2="GEN1" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_0" id2="NETWORK" var2="GEN1_BUS_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_0" id2="GEN1" var2="generator_running"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_1_value" id2="GEN2" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_1_value" id2="GEN2" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_1" id2="NETWORK" var2="GEN2_BUS_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_1" id2="GEN2" var2="generator_running"/>
  <dyn:connect id1="GEN1" var1="generator_terminal" id2="NETWORK" var2="GEN1_BUS_ACPIN"/>
  <dyn:connect id1="GEN1" var1="generator_switchOffSignal1" id2="NETWORK" var2="GEN1_BUS_switchOff"/>
  <dyn:connect id1="GEN2" var1="generator_terminal" id2="NETWORK" var2="GEN2_BUS_ACPIN"/>
  <dyn:connect id1="GEN2" var1="generator_switchOffSignal1" id2="NETWORK" var2="GEN2_BUS_switchOff"/>
  <dyn:connect id1="LOAD1" var1="load_terminal" id2="NETWORK" var2="LOAD1_BUS_ACPIN"/>
  <dyn:connect id1="LOAD2" var1="load_terminal" id2="NETWORK" var2="LOAD2_BUS_ACPIN"/>
  <dyn:connect id1="fault" var1="fault_terminal" id2="NETWORK" var2="GEN2_BUS_ACPIN"/>
</dyn:dynamicModelsArchitecture>
