<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="GEN1A" lib="GeneratorClassical" parFile="TwoZones.par" parId="1" staticId="GEN1A"/>
  <dyn:blackBoxModel id="GEN1B" lib="GeneratorClassical" parFile="TwoZones.par" parId="2" staticId="GEN1B"/>
  <dyn:blackBoxModel id="GEN2A" lib="GeneratorClassical" parFile="TwoZones.par" parId="3" staticId="GEN2A"/>
  <dyn:blackBoxModel id="GEN2B" lib="GeneratorClassical" parFile="TwoZones.par" parId="4" staticId="GEN2B"/>
  <dyn:blackBoxModel id="LOAD1" lib="LoadAlphaBeta" parFile="TwoZones.par" parId="5" staticId="LOAD1"/>
  <dyn:blackBoxModel id="LOAD2" lib="LoadAlphaBeta" parFile="TwoZones.par" parId="5" staticId="LOAD2"/>
  <dyn:blackBoxModel id="OMEGA_REF" lib="DYNModelOmegaRef" parFile="TwoZones.par" parId="6"/>
