  <dyn:connect id1="OMEGA_REF" var1="omega_grp_1_value" id2="GEN1B" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_1_value" id2="GEN1B" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_1" id2="NETWORK" var2="GEN1B_BUS_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_1" id2="GEN1B" var2="generator_running"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_2_value" id2="GEN2A" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_2_value" id2="GEN2A" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_2" id2="NETWORK" var2="GEN2A_BUS_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_2" id2="GEN2A" var2="generator_running"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_3_value" id2="GEN2B" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_3_value" id2="GEN2B" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_3" id2="NETWORK" var2="GEN2B_BUS_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_3" id2="GEN2B" var2="generator_running"/>
  <dyn:connect id1="GEN1A" var1="generator_terminal" id2="NETWORK" var2="GEN1A_BUS_ACPIN"/>
  <dyn:connect id1="GEN1A" var1="generator_switchOffSignal1" id2="NETWORK" var2="GEN1A_BUS_switchOff"/>
  <dyn:connect id1="GEN1B" var1="generator_terminal" id2="NETWORK" var2="GEN1B_BUS_ACPIN"/>
