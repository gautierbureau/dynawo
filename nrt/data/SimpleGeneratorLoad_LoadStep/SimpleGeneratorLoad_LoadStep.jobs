<dyn:jobs xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:job name="SimpleGeneratorLoad_LoadStep - IDA">
    <dyn:solver lib="dynawo_SolverIDA" parFile="SimpleGeneratorLoad_LoadStep.par" parId="SolverIDA"/>
    <dyn:modeler compileDir="outputs_ida/compilation">
      <dyn:dynModels dydFile="SimpleGeneratorLoad_LoadStep.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true"/>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="10"/>
    <dyn:outputs directory="outputs_ida">
      <dyn:curves inputFile="SimpleGeneratorLoad_LoadStep.crv" exportMode="CSV"/>
      <dyn:logs>
        <dyn:appender tag="" file="dynawo.log" lvlFilter="INFO"/>
      </dyn:logs>
    </dyn:outputs>
  </dyn:job>
  <dyn:job name="SimpleGeneratorLoad_LoadStep - SIM">
    <dyn:solver lib="dynawo_SolverSIM" parFile="SimpleGeneratorLoad_LoadStep.par" parId="SolverSIM"/>
    <dyn:modeler compileDir="outputs_sim/compilation">
      <dyn:dynModels dydFile="SimpleGeneratorLoad_LoadStep.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true"/>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="10"/>
    <dyn:outputs directory="outputs_sim">
      <dyn:curves inputFile="SimpleGeneratorLoad_LoadStep.crv" exportMode="CSV"/>
      <dyn:logs>
        <dyn:appender tag="" file="dynawo.log" lvlFilter="INFO"/>
      </dyn:logs>
    </dyn:outputs>
  </dyn:job>
</dyn:jobs>
