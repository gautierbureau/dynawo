<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="InfiniteBus" lib="InfiniteBus" parFile="SimpleGeneratorLoad_LoadStep.par" parId="InfiniteBus"/>
  <dyn:blackBoxModel id="Generator" lib="GeneratorAlphaBeta" parFile="SimpleGeneratorLoad_LoadStep.par" parId="Generator"/>
  <dyn:blackBoxModel id="Load" lib="LoadPQ" parFile="SimpleGeneratorLoad_LoadStep.par" parId="Load"/>
  <dyn:blackBoxModel id="StepP" lib="Step" parFile="SimpleGeneratorLoad_LoadStep.par" parId="StepP"/>
  <dyn:connect id1="Generator" var1="generator_terminal" id2="InfiniteBus" var2="infiniteBus_terminal"/>
  <dyn:connect id1="Load" var1="load_terminal" id2="InfiniteBus" var2="infiniteBus_terminal"/>
  <dyn:connect id1="StepP" var1="step_step" id2="Load" var2="load_PRefPu"/>
</dyn:dynamicModelsArchitecture>
