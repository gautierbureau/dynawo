<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">

  <!-- BE-G1: GENROE + VComp + Ac4a + Pss2b + GovSteam1 -->
  <dyn:blackBoxModel id="BE_G1" lib="GeneratorRoundRotorExpVCompIEEEType1Ac4aPss2bGovSteam1"
                     parFile="MicroGrid_BE_MAS.par" parId="BE_G1"
                     staticId="3a3b27be-b18b-4385-b557-6735d733baf0"/>

  <!-- BE-G2: standalone GENROE -->
  <dyn:blackBoxModel id="BE_G2" lib="GeneratorRoundRotorExp"
                     parFile="MicroGrid_BE_MAS.par" parId="BE_G2"
                     staticId="550ebe0d-f2b2-48c1-991f-cebea43a21aa"/>

  <!-- Loads -->
  <dyn:blackBoxModel id="LOAD_1" lib="LoadAlphaBeta" parFile="MicroGrid_BE_MAS.par" parId="Load" staticId="cb459405-cc14-4215-a45c-416789205904"/>
  <dyn:blackBoxModel id="LOAD_2" lib="LoadAlphaBeta" parFile="MicroGrid_BE_MAS.par" parId="Load" staticId="1c6beed6-1acf-42e7-ba55-0cc9f04bddd8"/>
  <dyn:blackBoxModel id="LOAD_3" lib="LoadAlphaBeta" parFile="MicroGrid_BE_MAS.par" parId="Load" staticId="b1480a00-b427-4001-a26c-51954d2bb7e9"/>

  <!-- OmegaRef barycenter and disturbance -->
  <dyn:blackBoxModel id="OMEGA_REF" lib="DYNModelOmegaRef" parFile="MicroGrid_BE_MAS.par" parId="OmegaRef"/>
  <dyn:blackBoxModel id="FAULT" lib="NodeFault" parFile="MicroGrid_BE_MAS.par" parId="Fault"/>
  <dyn:blackBoxModel id="LOADSTEP" lib="Step" parFile="MicroGrid_BE_MAS.par" parId="LoadStep"/>

  <!-- Terminals: explicit NETWORK ACPIN wiring -->
  <dyn:connect id1="BE_G1"  var1="generator_terminal"         id2="NETWORK" var2="4ba71b59-ee2f-450b-9f7d-cc2f1cc5e386_0_ACPIN"/>
  <dyn:connect id1="BE_G1"  var1="generator_switchOffSignal1" id2="NETWORK" var2="4ba71b59-ee2f-450b-9f7d-cc2f1cc5e386_0_switchOff"/>
  <dyn:connect id1="BE_G2"  var1="generator_terminal"         id2="NETWORK" var2="929ba893-c9dc-44d7-b1fd-30834bd3ab85_0_ACPIN"/>
  <dyn:connect id1="BE_G2"  var1="generator_switchOffSignal1" id2="NETWORK" var2="929ba893-c9dc-44d7-b1fd-30834bd3ab85_0_switchOff"/>
  <dyn:connect id1="LOAD_1" var1="load_terminal"              id2="NETWORK" var2="8bbd7e74-ae20-4dce-8780-c20f8e18c2e0_0_ACPIN"/>
  <dyn:connect id1="LOAD_2" var1="load_terminal"              id2="NETWORK" var2="b10b171b-3bc5-4849-bb1f-61ed9ea1ec7c_0_ACPIN"/>
  <dyn:connect id1="LOAD_3" var1="load_terminal"              id2="NETWORK" var2="69ef0dbd-da79-4eef-a02f-690cb8a28361_0_ACPIN"/>

  <!-- Disturbance: 10 % step on LOAD_1 active power at t = 1 s (200 MW -> 220 MW) -->
  <dyn:connect id1="LOADSTEP" var1="step_step" id2="LOAD_1" var2="load_deltaP"/>

  <!-- (NodeFault kept in DYD but disabled by tBegin past stopTime) -->
  <dyn:connect id1="FAULT" var1="fault_terminal" id2="NETWORK" var2="8bbd7e74-ae20-4dce-8780-c20f8e18c2e0_0_ACPIN"/>

  <!-- OmegaRef -->
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_0_value"    id2="BE_G1" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_0_value" id2="BE_G1" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_0_value" id2="BE_G1" var2="pss_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_0"         id2="NETWORK" var2="4ba71b59-ee2f-450b-9f7d-cc2f1cc5e386_0_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_0"        id2="BE_G1" var2="generator_running"/>
  <dyn:connect id1="OMEGA_REF" var1="omega_grp_1_value"    id2="BE_G2" var2="generator_omegaPu"/>
  <dyn:connect id1="OMEGA_REF" var1="omegaRef_grp_1_value" id2="BE_G2" var2="generator_omegaRefPu"/>
  <dyn:connect id1="OMEGA_REF" var1="numcc_node_1"         id2="NETWORK" var2="929ba893-c9dc-44d7-b1fd-30834bd3ab85_0_numcc"/>
  <dyn:connect id1="OMEGA_REF" var1="running_grp_1"        id2="BE_G2" var2="generator_running"/>
</dyn:dynamicModelsArchitecture>
