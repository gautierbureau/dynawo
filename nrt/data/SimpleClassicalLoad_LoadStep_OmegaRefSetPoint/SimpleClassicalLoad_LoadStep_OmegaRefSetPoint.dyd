<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="GEN" lib="GeneratorClassical" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="Generator" staticId="GEN"/>
  <dyn:blackBoxModel id="LOAD" lib="LoadPQ" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="Load" staticId="LOAD"/>
  <dyn:blackBoxModel id="OMEGA_REF" lib="SetPoint" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="OmegaRef"/>
  <dyn:blackBoxModel id="StepP" lib="Step" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="StepP"/>
  <!-- Generator and load attach to the IIDM bus -->
  <dyn:connect id1="GEN" var1="generator_terminal" id2="NETWORK" var2="BUS_ACPIN"/>
  <dyn:connect id1="GEN" var1="generator_switchOffSignal1" id2="NETWORK" var2="BUS_switchOff"/>
  <dyn:connect id1="LOAD" var1="load_terminal" id2="NETWORK" var2="BUS_ACPIN"/>
  <!-- Fixed omegaRefPu = 1 pu (replaces the DYNModelOmegaRef black box) -->
  <dyn:connect id1="OMEGA_REF" var1="setPoint_setPoint" id2="GEN" var2="generator_omegaRefPu"/>
  <!-- Load step -->
  <dyn:connect id1="StepP" var1="step_step" id2="LOAD" var2="load_PRefPu"/>
</dyn:dynamicModelsArchitecture>
