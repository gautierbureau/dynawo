<dyn:jobs xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:job name="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint - IDA">
    <dyn:solver lib="dynawo_SolverIDA" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="SolverIDA"/>
    <dyn:modeler compileDir="outputs_ida/compilation">
      <dyn:network iidmFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.iidm" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="Network"/>
      <dyn:dynModels dydFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true"/>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="10"/>
    <dyn:outputs directory="outputs_ida">
      <dyn:curves inputFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.crv" exportMode="CSV"/>
      <dyn:logs>
        <dyn:appender tag="" file="dynawo.log" lvlFilter="INFO"/>
      </dyn:logs>
    </dyn:outputs>
  </dyn:job>
  <dyn:job name="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint - SIM">
    <dyn:solver lib="dynawo_SolverSIM" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="SolverSIM"/>
    <dyn:modeler compileDir="outputs_sim/compilation">
      <dyn:network iidmFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.iidm" parFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.par" parId="Network"/>
      <dyn:dynModels dydFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true"/>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="10"/>
    <dyn:outputs directory="outputs_sim">
      <dyn:curves inputFile="SimpleClassicalLoad_LoadStep_OmegaRefSetPoint.crv" exportMode="CSV"/>
      <dyn:logs>
        <dyn:appender tag="" file="dynawo.log" lvlFilter="INFO"/>
      </dyn:logs>
    </dyn:outputs>
  </dyn:job>
</dyn:jobs>
