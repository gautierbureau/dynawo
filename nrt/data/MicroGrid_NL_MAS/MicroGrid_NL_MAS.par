    All parameters mapped 1:1 from the ENTSO-E MicroGrid NL-MAS CGMES DY profile
    (20210420T1730Z_1D_NL_DY_001.xml) into Dynawo Modelica parameter names.
-->
<parametersSet xmlns="http://www.rte-france.com/dynawo">

  <!-- ============== Network (load flow propagation) ============== -->
  <set id="Network">
    <par type="DOUBLE" name="capacitor_no_reclosing_delay" value="300"/>
    <par type="DOUBLE" name="dangling_line_currentLimit_maxTimeOperation" value="240"/>
    <par type="DOUBLE" name="line_currentLimit_maxTimeOperation" value="240"/>
    <par type="DOUBLE" name="load_Tp" value="90"/>
    <par type="DOUBLE" name="load_Tq" value="90"/>
    <par type="DOUBLE" name="load_alpha" value="1"/>
    <par type="DOUBLE" name="load_alphaLong" value="0"/>
    <par type="DOUBLE" name="load_beta" value="2"/>
    <par type="DOUBLE" name="load_betaLong" value="0"/>
    <par type="BOOL"   name="load_isControllable" value="false"/>
    <par type="BOOL"   name="load_isRestorative" value="false"/>
    <par type="DOUBLE" name="load_zPMax" value="100"/>
    <par type="DOUBLE" name="load_zQMax" value="100"/>
    <par type="DOUBLE" name="reactance_no_reclosing_delay" value="0"/>
    <par type="DOUBLE" name="transformer_currentLimit_maxTimeOperation" value="240"/>
    <par type="DOUBLE" name="transformer_t1st_HT" value="60"/>
    <par type="DOUBLE" name="transformer_t1st_THT" value="30"/>
    <par type="DOUBLE" name="transformer_tNext_HT" value="10"/>
    <par type="DOUBLE" name="transformer_tNext_THT" value="10"/>
    <par type="DOUBLE" name="transformer_tolV" value="0.014999999700000001"/>
  </set>

  <!-- ============== Loads (alpha-beta) ============== -->
  <set id="Load">
    <par type="DOUBLE" name="load_alpha" value="1.5"/>
    <par type="DOUBLE" name="load_beta"  value="2.5"/>
    <reference name="load_P0Pu"     origData="IIDM" origName="p_pu"     type="DOUBLE"/>
    <reference name="load_Q0Pu"     origData="IIDM" origName="q_pu"     type="DOUBLE"/>
    <reference name="load_U0Pu"     origData="IIDM" origName="v_pu"     type="DOUBLE"/>
    <reference name="load_UPhase0"  origData="IIDM" origName="angle_pu" type="DOUBLE"/>
  </set>

  <!-- ============== NL_G1 (CGMES SMTCR bd63d5d8 + ExcAC1A + Pss2B + VComp + GovHydro2/IEEEG3) ============== -->
  <set id="NL_G1">
    <reference name="generator_P0Pu"     origData="IIDM" origName="p_pu"     type="DOUBLE"/>
    <reference name="generator_Q0Pu"     origData="IIDM" origName="q_pu"     type="DOUBLE"/>
    <reference name="generator_U0Pu"     origData="IIDM" origName="v_pu"     type="DOUBLE"/>
    <reference name="generator_UPhase0"  origData="IIDM" origName="angle_pu" type="DOUBLE"/>
    <!-- Synchronous machine (CGMES SMTCR bd63d5d8, salientPole) -->
    <par type="DOUBLE" name="generator_H"        value="9.9"/>
    <par type="DOUBLE" name="generator_DPu"      value="1"/>
    <par type="DOUBLE" name="generator_RaPu"     value="0"/>
    <par type="DOUBLE" name="generator_XlPu"    value="0.1934"/>
    <par type="DOUBLE" name="generator_Se1Pu"   value="0"/>
    <par type="DOUBLE" name="generator_Se12Pu"  value="0"/>
    <par type="DOUBLE" name="generator_XdPu"    value="2.35"/>
    <par type="DOUBLE" name="generator_XpdPu"   value="0.452"/>
    <par type="DOUBLE" name="generator_XppdPu"  value="0.318"/>
    <par type="DOUBLE" name="generator_XqPu"    value="2.24"/>
    <par type="DOUBLE" name="generator_XppqPu"  value="0.318"/>
    <par type="DOUBLE" name="generator_Tpd0"    value="8.8"/>
    <par type="DOUBLE" name="generator_Tppd0"   value="0.031"/>
    <par type="DOUBLE" name="generator_Tppq0"   value="0.0354"/>
    <par type="DOUBLE" name="generator_SNom"    value="1100"/>
    <!-- VCompIEEEType1 (CGMES NL-G1-Vcomp) -->
    <par type="DOUBLE" name="compensator_RcPu"  value="0"/>
    <par type="DOUBLE" name="compensator_XcPu"  value="0"/>
    <par type="DOUBLE" name="compensator_SNom"  value="1100"/>
    <!-- ExcIEEEAC1A (CGMES NL-G1-ExcAC1A);
         CGMES seve1=0.03,ve1=3.14 ; seve2=0.1,ve2=4.18 -> AEx, BEx of exciter saturation
         BEx = ln(seve1*ve1/(seve2*ve2)) / (ve1 - ve2) = ln(0.0942/0.418) / (3.14-4.18) = ln(0.2253) / (-1.04) = -1.4904/-1.04 = 1.4331
         AEx = seve1*ve1 * exp(-BEx*ve1) = 0.0942 * exp(-4.4999) = 0.0942 * 0.01111 = 0.001046 -->
    <par type="DOUBLE" name="voltageRegulator_AEx"     value="0.001046"/>
    <par type="DOUBLE" name="voltageRegulator_BEx"     value="1.4331"/>
    <par type="DOUBLE" name="voltageRegulator_EfeMaxPu" value="999"/>
    <par type="DOUBLE" name="voltageRegulator_EfeMinPu" value="-999"/>
    <par type="DOUBLE" name="voltageRegulator_Ka"      value="30"/>
    <par type="DOUBLE" name="voltageRegulator_Kc"      value="0.2"/>
    <par type="DOUBLE" name="voltageRegulator_Kd"      value="0.4"/>
    <par type="DOUBLE" name="voltageRegulator_Ke"      value="1"/>
    <par type="DOUBLE" name="voltageRegulator_Kf"      value="0.03"/>
    <par type="DOUBLE" name="voltageRegulator_tA"      value="0.05"/>
    <par type="DOUBLE" name="voltageRegulator_tB"      value="0.02"/>
    <par type="DOUBLE" name="voltageRegulator_tC"      value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_tE"      value="0.4"/>
    <par type="DOUBLE" name="voltageRegulator_tF"      value="1"/>
    <par type="DOUBLE" name="voltageRegulator_TolLi"   value="0.0001"/>
    <par type="DOUBLE" name="voltageRegulator_tR"      value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_VaMaxPu" value="10"/>
    <par type="DOUBLE" name="voltageRegulator_VaMinPu" value="-10"/>
    <par type="DOUBLE" name="voltageRegulator_Ir0Pu"   value="0"/>
    <par type="DOUBLE" name="voltageRegulator_UOel0Pu" value="999"/>
    <par type="DOUBLE" name="voltageRegulator_UUel0Pu" value="-999"/>
    <!-- PssIEEE2B (CGMES NL-G1-PSSB); t10=t11=t6=0 bumped to 1e-3 to break init Jacobian singularity -->
    <par type="DOUBLE" name="pss_KOmega"     value="1"/>
    <par type="DOUBLE" name="pss_KOmegaRef"  value="-1"/>
    <par type="DOUBLE" name="pss_Ks1"        value="12"/>
    <par type="DOUBLE" name="pss_Ks2"        value="0.2"/>
    <par type="DOUBLE" name="pss_Ks3"        value="1"/>
    <par type="INT"    name="pss_M"          value="5"/>
    <par type="INT"    name="pss_N"          value="1"/>
    <par type="DOUBLE" name="pss_OmegaMaxPu" value="999"/>
    <par type="DOUBLE" name="pss_OmegaMinPu" value="-999"/>
    <par type="DOUBLE" name="pss_PGenMaxPu"  value="999"/>
    <par type="DOUBLE" name="pss_PGenMinPu"  value="-999"/>
    <par type="DOUBLE" name="pss_t1"  value="0.12"/>
    <par type="DOUBLE" name="pss_t2"  value="0.02"/>
    <par type="DOUBLE" name="pss_t3"  value="0.3"/>
    <par type="DOUBLE" name="pss_t4"  value="0.02"/>
    <par type="DOUBLE" name="pss_t6"  value="0.001"/>
    <par type="DOUBLE" name="pss_t7"  value="2"/>
    <par type="DOUBLE" name="pss_t8"  value="0.001"/>
    <par type="DOUBLE" name="pss_t9"  value="0.1"/>
    <par type="DOUBLE" name="pss_t10" value="0.001"/>
    <par type="DOUBLE" name="pss_t11" value="0.001"/>
    <par type="DOUBLE" name="pss_tW1" value="2"/>
    <par type="DOUBLE" name="pss_tW2" value="2"/>
    <par type="DOUBLE" name="pss_tW3" value="2"/>
    <par type="DOUBLE" name="pss_tW4" value="0"/>
    <par type="DOUBLE" name="pss_VPssMaxPu" value="0.1"/>
    <par type="DOUBLE" name="pss_VPssMinPu" value="-0.1"/>
    <par type="DOUBLE" name="pss_SNom" value="1100"/>
    <!-- GovHydro2 / IEEEG3 (CGMES NL-G1-IEEEEG3) -->
    <par type="DOUBLE" name="governor_RPerm" value="0.05"/>
    <par type="DOUBLE" name="governor_RTemp" value="0.52"/>
    <par type="DOUBLE" name="governor_tP"    value="0.04"/>
    <par type="DOUBLE" name="governor_tG"    value="1"/>
    <par type="DOUBLE" name="governor_tR"    value="9.19"/>
    <par type="DOUBLE" name="governor_PMax"  value="1"/>
    <par type="DOUBLE" name="governor_PMin"  value="-1"/>
    <par type="DOUBLE" name="governor_UO"    value="0.2"/>
    <par type="DOUBLE" name="governor_UC"    value="-0.2"/>
    <par type="DOUBLE" name="governor_DeltaOmegaDbPu" value="0"/>
    <par type="DOUBLE" name="governor_ATurb" value="-1"/>
    <par type="DOUBLE" name="governor_BTurb" value="0.5"/>
    <par type="DOUBLE" name="governor_KTurb" value="1"/>
    <par type="DOUBLE" name="governor_tW"    value="1.84"/>
  </set>

  <!-- ============== NL_G2 (CGMES SMTCR e58068fe + ExcST1A + Pss2B + VComp + GovHydro1) ============== -->
  <set id="NL_G2">
    <reference name="generator_P0Pu"     origData="IIDM" origName="p_pu"     type="DOUBLE"/>
    <reference name="generator_Q0Pu"     origData="IIDM" origName="q_pu"     type="DOUBLE"/>
    <reference name="generator_U0Pu"     origData="IIDM" origName="v_pu"     type="DOUBLE"/>
    <reference name="generator_UPhase0"  origData="IIDM" origName="angle_pu" type="DOUBLE"/>
    <!-- Synchronous machine (CGMES SMTCR e58068fe, salientPole); no saturation factor in DY -> Se1Pu=Se12Pu=0 -->
    <par type="DOUBLE" name="generator_H"        value="4.4"/>
    <par type="DOUBLE" name="generator_DPu"      value="1"/>
    <par type="DOUBLE" name="generator_RaPu"     value="0"/>
    <par type="DOUBLE" name="generator_XlPu"    value="0.23"/>
    <par type="DOUBLE" name="generator_Se1Pu"   value="0"/>
    <par type="DOUBLE" name="generator_Se12Pu"  value="0"/>
    <par type="DOUBLE" name="generator_XdPu"    value="1.98"/>
    <par type="DOUBLE" name="generator_XpdPu"   value="0.37"/>
    <par type="DOUBLE" name="generator_XppdPu"  value="0.24"/>
    <par type="DOUBLE" name="generator_XqPu"    value="0.8"/>
    <par type="DOUBLE" name="generator_XppqPu"  value="0.24"/>
    <par type="DOUBLE" name="generator_Tpd0"    value="9.6"/>
    <par type="DOUBLE" name="generator_Tppd0"   value="0.08"/>
    <par type="DOUBLE" name="generator_Tppq0"   value="0.0837"/>
    <par type="DOUBLE" name="generator_SNom"    value="250"/>
    <!-- VCompIEEEType1 (CGMES NL-G2-Vcomp) -->
    <par type="DOUBLE" name="compensator_RcPu"  value="0"/>
    <par type="DOUBLE" name="compensator_XcPu"  value="0"/>
    <par type="DOUBLE" name="compensator_SNom"  value="250"/>
    <!-- ExcIEEEST1A (CGMES NL-G2-Exc-ST1A); uelin=ignore -> PositionUel=0, pssin=false -> PositionPss=1 (default) -->
    <par type="DOUBLE" name="voltageRegulator_Ir0Pu"   value="0"/>
    <par type="DOUBLE" name="voltageRegulator_IlrPu"   value="0"/>
    <par type="DOUBLE" name="voltageRegulator_Ka"      value="190"/>
    <par type="DOUBLE" name="voltageRegulator_Kc"      value="0.08"/>
    <par type="DOUBLE" name="voltageRegulator_Kf"      value="0.02"/>
    <par type="DOUBLE" name="voltageRegulator_Klr"     value="0"/>
    <par type="INT"    name="voltageRegulator_PositionPss" value="1"/>
    <par type="INT"    name="voltageRegulator_PositionUel" value="0"/>
    <par type="DOUBLE" name="voltageRegulator_tA"      value="0.1"/>
    <par type="DOUBLE" name="voltageRegulator_tB"      value="10"/>
    <par type="DOUBLE" name="voltageRegulator_tB1"     value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_tC"      value="1.5"/>
    <par type="DOUBLE" name="voltageRegulator_tC1"     value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_tF"      value="0.8"/>
    <par type="DOUBLE" name="voltageRegulator_tR"      value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_VaMaxPu" value="8"/>
    <par type="DOUBLE" name="voltageRegulator_VaMinPu" value="-8"/>
    <par type="DOUBLE" name="voltageRegulator_ViMaxPu" value="0.2"/>
    <par type="DOUBLE" name="voltageRegulator_ViMinPu" value="-0.2"/>
    <par type="DOUBLE" name="voltageRegulator_VrMaxPu" value="7.8"/>
    <par type="DOUBLE" name="voltageRegulator_VrMinPu" value="-6.7"/>
    <par type="DOUBLE" name="voltageRegulator_UOel0Pu" value="999"/>
    <par type="DOUBLE" name="voltageRegulator_UUel0Pu" value="-999"/>
    <!-- PssIEEE2B (CGMES NL-G2-PSSB) -->
    <par type="DOUBLE" name="pss_KOmega"     value="1"/>
    <par type="DOUBLE" name="pss_KOmegaRef"  value="-1"/>
    <par type="DOUBLE" name="pss_Ks1"        value="10"/>
    <par type="DOUBLE" name="pss_Ks2"        value="0.31"/>
    <par type="DOUBLE" name="pss_Ks3"        value="1"/>
    <par type="INT"    name="pss_M"          value="5"/>
    <par type="INT"    name="pss_N"          value="1"/>
    <par type="DOUBLE" name="pss_OmegaMaxPu" value="999"/>
    <par type="DOUBLE" name="pss_OmegaMinPu" value="-999"/>
    <par type="DOUBLE" name="pss_PGenMaxPu"  value="999"/>
    <par type="DOUBLE" name="pss_PGenMinPu"  value="-999"/>
    <par type="DOUBLE" name="pss_t1"  value="0.12"/>
    <par type="DOUBLE" name="pss_t2"  value="0.02"/>
    <par type="DOUBLE" name="pss_t3"  value="0.4"/>
    <par type="DOUBLE" name="pss_t4"  value="0.02"/>
    <par type="DOUBLE" name="pss_t6"  value="0.001"/>
    <par type="DOUBLE" name="pss_t7"  value="2"/>
    <par type="DOUBLE" name="pss_t8"  value="0.2"/>
    <par type="DOUBLE" name="pss_t9"  value="0.1"/>
    <par type="DOUBLE" name="pss_t10" value="0.001"/>
    <par type="DOUBLE" name="pss_t11" value="0.001"/>
    <par type="DOUBLE" name="pss_tW1" value="2"/>
    <par type="DOUBLE" name="pss_tW2" value="2"/>
    <par type="DOUBLE" name="pss_tW3" value="2"/>
    <par type="DOUBLE" name="pss_tW4" value="0"/>
    <par type="DOUBLE" name="pss_VPssMaxPu" value="0.1"/>
    <par type="DOUBLE" name="pss_VPssMinPu" value="-0.1"/>
    <par type="DOUBLE" name="pss_SNom" value="250"/>
    <!-- GovHydro1 (CGMES NL-G2-Turb-GovHydro1) -->
    <par type="DOUBLE" name="governor_RPerm" value="0.05"/>
    <par type="DOUBLE" name="governor_RTemp" value="1.27"/>
    <par type="DOUBLE" name="governor_tFilter" value="0.099"/>
    <par type="DOUBLE" name="governor_tG"      value="0.9"/>
    <par type="DOUBLE" name="governor_tR"      value="10.4"/>
    <par type="DOUBLE" name="governor_GMax"    value="0.75"/>
    <par type="DOUBLE" name="governor_GMin"    value="0"/>
    <par type="DOUBLE" name="governor_VelMax"  value="0.2"/>
    <par type="DOUBLE" name="governor_ATurb"   value="1.2"/>
    <par type="DOUBLE" name="governor_HDam"    value="1"/>
    <par type="DOUBLE" name="governor_QNl"     value="0.08"/>
    <par type="DOUBLE" name="governor_DTurb"   value="0.3"/>
    <par type="DOUBLE" name="governor_tW"      value="2.6"/>
    <par type="DOUBLE" name="governor_tDeriv"  value="0.02"/>
  </set>

  <!-- ============== NL_G3 (CGMES SMTCR f450a965 + ExcST1A + Pss2B + VComp + GovHydro1) ============== -->
  <set id="NL_G3">
    <reference name="generator_P0Pu"     origData="IIDM" origName="p_pu"     type="DOUBLE"/>
    <reference name="generator_Q0Pu"     origData="IIDM" origName="q_pu"     type="DOUBLE"/>
    <reference name="generator_U0Pu"     origData="IIDM" origName="v_pu"     type="DOUBLE"/>
    <reference name="generator_UPhase0"  origData="IIDM" origName="angle_pu" type="DOUBLE"/>
    <!-- Synchronous machine (CGMES SMTCR f450a965, salientPole); saturationFactor=0.02, saturationFactor120=0.12 -->
    <par type="DOUBLE" name="generator_H"        value="4.4"/>
    <par type="DOUBLE" name="generator_DPu"      value="1"/>
    <par type="DOUBLE" name="generator_RaPu"     value="0"/>
    <par type="DOUBLE" name="generator_XlPu"    value="0.23"/>
    <par type="DOUBLE" name="generator_Se1Pu"   value="0.02"/>
    <par type="DOUBLE" name="generator_Se12Pu"  value="0.12"/>
    <par type="DOUBLE" name="generator_XdPu"    value="1.98"/>
    <par type="DOUBLE" name="generator_XpdPu"   value="0.37"/>
    <par type="DOUBLE" name="generator_XppdPu"  value="0.24"/>
    <par type="DOUBLE" name="generator_XqPu"    value="0.8"/>
    <par type="DOUBLE" name="generator_XppqPu"  value="0.24"/>
    <par type="DOUBLE" name="generator_Tpd0"    value="9.6"/>
    <par type="DOUBLE" name="generator_Tppd0"   value="0.08"/>
    <par type="DOUBLE" name="generator_Tppq0"   value="0.0837"/>
    <par type="DOUBLE" name="generator_SNom"    value="250"/>
    <!-- VCompIEEEType1 (CGMES NL-G3-Vcomp) -->
    <par type="DOUBLE" name="compensator_RcPu"  value="0"/>
    <par type="DOUBLE" name="compensator_XcPu"  value="0"/>
    <par type="DOUBLE" name="compensator_SNom"  value="250"/>
    <!-- ExcIEEEST1A (CGMES NL-G3-Exc-ST1A) -->
    <par type="DOUBLE" name="voltageRegulator_Ir0Pu"   value="0"/>
    <par type="DOUBLE" name="voltageRegulator_IlrPu"   value="0"/>
    <par type="DOUBLE" name="voltageRegulator_Ka"      value="220"/>
    <par type="DOUBLE" name="voltageRegulator_Kc"      value="0.08"/>
    <par type="DOUBLE" name="voltageRegulator_Kf"      value="0.02"/>
    <par type="DOUBLE" name="voltageRegulator_Klr"     value="0"/>
    <par type="INT"    name="voltageRegulator_PositionPss" value="1"/>
    <par type="INT"    name="voltageRegulator_PositionUel" value="0"/>
    <par type="DOUBLE" name="voltageRegulator_tA"      value="0.1"/>
    <par type="DOUBLE" name="voltageRegulator_tB"      value="10"/>
    <par type="DOUBLE" name="voltageRegulator_tB1"     value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_tC"      value="1.5"/>
    <par type="DOUBLE" name="voltageRegulator_tC1"     value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_tF"      value="0.8"/>
    <par type="DOUBLE" name="voltageRegulator_tR"      value="0.001"/>
    <par type="DOUBLE" name="voltageRegulator_VaMaxPu" value="8"/>
    <par type="DOUBLE" name="voltageRegulator_VaMinPu" value="-8"/>
    <par type="DOUBLE" name="voltageRegulator_ViMaxPu" value="0.2"/>
    <par type="DOUBLE" name="voltageRegulator_ViMinPu" value="-0.2"/>
    <par type="DOUBLE" name="voltageRegulator_VrMaxPu" value="7.8"/>
    <par type="DOUBLE" name="voltageRegulator_VrMinPu" value="-6.7"/>
    <par type="DOUBLE" name="voltageRegulator_UOel0Pu" value="999"/>
    <par type="DOUBLE" name="voltageRegulator_UUel0Pu" value="-999"/>
    <!-- PssIEEE2B (CGMES NL-G3-PSSB) -->
    <par type="DOUBLE" name="pss_KOmega"     value="1"/>
    <par type="DOUBLE" name="pss_KOmegaRef"  value="-1"/>
    <par type="DOUBLE" name="pss_Ks1"        value="10"/>
    <par type="DOUBLE" name="pss_Ks2"        value="0.31"/>
    <par type="DOUBLE" name="pss_Ks3"        value="1"/>
    <par type="INT"    name="pss_M"          value="5"/>
    <par type="INT"    name="pss_N"          value="1"/>
    <par type="DOUBLE" name="pss_OmegaMaxPu" value="999"/>
    <par type="DOUBLE" name="pss_OmegaMinPu" value="-999"/>
    <par type="DOUBLE" name="pss_PGenMaxPu"  value="999"/>
    <par type="DOUBLE" name="pss_PGenMinPu"  value="-999"/>
    <par type="DOUBLE" name="pss_t1"  value="0.3"/>
    <par type="DOUBLE" name="pss_t2"  value="0.02"/>
    <par type="DOUBLE" name="pss_t3"  value="0.45"/>
    <par type="DOUBLE" name="pss_t4"  value="0.02"/>
    <par type="DOUBLE" name="pss_t6"  value="0.001"/>
    <par type="DOUBLE" name="pss_t7"  value="2"/>
    <par type="DOUBLE" name="pss_t8"  value="0.2"/>
    <par type="DOUBLE" name="pss_t9"  value="0.1"/>
    <par type="DOUBLE" name="pss_t10" value="0.001"/>
    <par type="DOUBLE" name="pss_t11" value="0.001"/>
    <par type="DOUBLE" name="pss_tW1" value="2"/>
    <par type="DOUBLE" name="pss_tW2" value="2"/>
    <par type="DOUBLE" name="pss_tW3" value="2"/>
    <par type="DOUBLE" name="pss_tW4" value="0"/>
    <par type="DOUBLE" name="pss_VPssMaxPu" value="0.1"/>
    <par type="DOUBLE" name="pss_VPssMinPu" value="-0.1"/>
    <par type="DOUBLE" name="pss_SNom" value="250"/>
    <!-- GovHydro1 (CGMES NL-G3-GovHydro1; identical to NL-G2) -->
    <par type="DOUBLE" name="governor_RPerm" value="0.05"/>
    <par type="DOUBLE" name="governor_RTemp" value="1.27"/>
    <par type="DOUBLE" name="governor_tFilter" value="0.099"/>
    <par type="DOUBLE" name="governor_tG"      value="0.9"/>
    <par type="DOUBLE" name="governor_tR"      value="10.4"/>
    <par type="DOUBLE" name="governor_GMax"    value="0.75"/>
    <par type="DOUBLE" name="governor_GMin"    value="0"/>
    <par type="DOUBLE" name="governor_VelMax"  value="0.2"/>
    <par type="DOUBLE" name="governor_ATurb"   value="1.2"/>
    <par type="DOUBLE" name="governor_HDam"    value="1"/>
    <par type="DOUBLE" name="governor_QNl"     value="0.08"/>
    <par type="DOUBLE" name="governor_DTurb"   value="0.3"/>
    <par type="DOUBLE" name="governor_tW"      value="2.6"/>
    <par type="DOUBLE" name="governor_tDeriv"  value="0.02"/>
  </set>

  <!-- ============== Frequency barycenter across the three NL machines ============== -->
  <set id="OmegaRef">
    <par type="INT"    name="nbGen" value="3"/>
    <par type="DOUBLE" name="weight_gen_0" value="10890"/>   <!-- H * SNom NL_G1 (9.9 * 1100) -->
    <par type="DOUBLE" name="weight_gen_1" value="1100"/>    <!-- H * SNom NL_G2 (4.4 * 250)  -->
    <par type="DOUBLE" name="weight_gen_2" value="1100"/>    <!-- H * SNom NL_G3 (4.4 * 250)  -->
  </set>

  <!-- ============== +10 % step on NL-Load_3 active power at t = 1 s ============== -->
  <set id="LoadStep">
    <par type="DOUBLE" name="step_Value0" value="0"/>
    <par type="DOUBLE" name="step_Height" value="0.1"/>
    <par type="DOUBLE" name="step_tStep"  value="1.0"/>
  </set>

  <!-- ============== Zero rotor-current placeholder for Ac1a / St1a IrPu input ============== -->
  <set id="ZeroIr">
    <par type="DOUBLE" name="setPoint_Value0" value="0"/>
  </set>
</parametersSet>
