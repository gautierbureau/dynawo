<dyn:jobs xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:job name="TestCasePFVArType2IEEEPFController - Step on QGen drives PF away from PfRef">
    <dyn:solver lib="dynawo_SolverIDA" parFile="TestCasePFVArType2IEEEPFController.par" parId="IDAOrder2"/>
    <dyn:modeler compileDir="outputsTestCasePFVArType2IEEEPFController/compilation">
      <dyn:dynModels dydFile="TestCasePFVArType2IEEEPFController.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true">
        <dyn:directory path="." recursive="false"/>
      </dyn:modelicaModels>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="60"/>
    <dyn:outputs directory="outputsTestCasePFVArType2IEEEPFController">
      <dyn:curves inputFile="TestCasePFVArType2IEEEPFController.crv" exportMode="CSV"/>
      <dyn:logs><dyn:appender tag="" file="dynawo.log" lvlFilter="INFO"/></dyn:logs>
    </dyn:outputs>
  </dyn:job>
</dyn:jobs>
