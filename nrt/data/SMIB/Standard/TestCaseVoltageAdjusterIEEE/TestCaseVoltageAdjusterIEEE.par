<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="Adjuster">
    <par type="DOUBLE" name="adjuster_AdjSlew" value="0.01"/>
    <par type="DOUBLE" name="adjuster_VrMaxPu" value="0.1"/>
    <par type="DOUBLE" name="adjuster_VrMinPu" value="-0.1"/>
    <par type="DOUBLE" name="adjuster_VRef0"   value="0.0"/>
  </set>
  <set id="VRefStep">
    <par type="DOUBLE" name="step_Value0" value="0.0"/>
    <par type="DOUBLE" name="step_Height" value="0.2"/>
    <par type="DOUBLE" name="step_tStep"  value="5.0"/>
  </set>
  <set id="IDAOrder2">
    <par type="INT"    name="order" value="2"/>
    <par type="DOUBLE" name="initStep"    value="0.000001"/>
    <par type="DOUBLE" name="minStep"     value="0.000001"/>
    <par type="DOUBLE" name="maxStep"     value="1"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
  </set>
</parametersSet>
