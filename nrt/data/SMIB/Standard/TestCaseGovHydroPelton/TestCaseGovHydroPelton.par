<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="SynchronousGenerator">
    <par type="DOUBLE" name="generator_H" value="4.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.003"/>
    <par type="DOUBLE" name="generator_XdPu" value="2.0"/>
    <par type="DOUBLE" name="generator_XpdPu" value="0.3"/>
    <par type="DOUBLE" name="generator_XqPu" value="1.9"/>
    <par type="DOUBLE" name="generator_Tpd0" value="7.0"/>
    <par type="DOUBLE" name="generator_SNom" value="100.0"/>
    <par type="DOUBLE" name="generator_P0Pu" value="-0.7"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="generator_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="generator_UPhase0" value="0.0"/>
    <!-- Governor (GovHydroPelton: Pelton wheel governor with needle servo + dashpot compensator + non-minimum-phase water column) -->
    <par type="DOUBLE" name="governor_Bp"      value="0.04"/>
    <par type="DOUBLE" name="governor_Kg"     value="1.5"/>
    <par type="DOUBLE" name="governor_Kc"     value="0.3"/>
    <par type="DOUBLE" name="governor_tD"    value="5.0"/>
    <par type="DOUBLE" name="governor_tA"    value="0.1"/>
    <par type="DOUBLE" name="governor_tS"    value="0.1"/>
    <par type="DOUBLE" name="governor_tX"    value="1.0"/>
    <par type="DOUBLE" name="governor_tWng"  value="1.0"/>
    <par type="DOUBLE" name="governor_tWnc"  value="0.5"/>
    <par type="DOUBLE" name="governor_Valvmax" value="0.05"/>
    <par type="DOUBLE" name="governor_Valvmin" value="-0.05"/>
    <par type="DOUBLE" name="governor_Hn"    value="1.0"/>
    <par type="DOUBLE" name="governor_H1"    value="1.0"/>
    <par type="DOUBLE" name="governor_H2"    value="1.0"/>
    <par type="DOUBLE" name="governor_Qn"    value="1.0"/>
    <par type="DOUBLE" name="governor_Qc0"   value="0.0"/>
    <par type="DOUBLE" name="governor_Db1"   value="0.0"/>
    <par type="DOUBLE" name="governor_Db2"   value="0.0"/>
    <par type="DOUBLE" name="governor_Av0"   value="0.1"/>
    <par type="DOUBLE" name="governor_Av1"   value="0.1"/>
    <par type="DOUBLE" name="governor_Vav"   value="0.5"/>
    <par type="DOUBLE" name="governor_Va"    value="0.2"/>
    <par type="DOUBLE" name="governor_Vc"    value="1.0"/>
    <par type="DOUBLE" name="governor_Vcv"   value="1.0"/>
    <par type="DOUBLE" name="governor_SimplifiedPelton" value="1.0"/>
    <par type="DOUBLE" name="governor_StaticCompensating" value="0.0"/>
    <par type="BOOL"   name="governor_Cfrac" value="false"/>
    <par type="BOOL"   name="governor_Sfrac" value="false"/>
  </set>
  <set id="OmegaRef">
    <par type="INT" name="nbGen" value="1"/>
    <par type="DOUBLE" name="weight_gen_0" value="100.0"/>
  </set>
  <set id="Load">
    <par type="DOUBLE" name="load_P0Pu" value="0.7"/>
    <par type="DOUBLE" name="load_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="load_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="load_UPhase0" value="0.0"/>
    <par type="DOUBLE" name="load_alpha" value="2.0"/>
    <par type="DOUBLE" name="load_beta" value="2.0"/>
  </set>
  <set id="StepP">
    <par type="DOUBLE" name="step_Value0" value="0.7"/>
    <par type="DOUBLE" name="step_Height" value="0.02"/>
    <par type="DOUBLE" name="step_tStep" value="1.0"/>
  </set>
  <set id="IDA">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="0.000001"/>
    <par type="DOUBLE" name="minStep" value="0.000001"/>
    <par type="DOUBLE" name="maxStep" value="1"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
  </set>
</parametersSet>
