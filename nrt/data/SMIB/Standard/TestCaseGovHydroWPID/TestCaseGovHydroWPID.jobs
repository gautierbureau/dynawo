<dyn:jobs xmlns:dyn="http://www.rte-france.com/dynawo">
 <dyn:job name="TestCaseGovHydroWPID - Active power variation on the load">
      <dyn:solver lib="dynawo_SolverIDA" parFile="TestCaseGovHydroWPID.par" parId="IDA"/>
      <dyn:modeler compileDir="outputsTestCaseGovHydroWPID/compilation">
        <dyn:dynModels dydFile="TestCaseGovHydroWPID.dyd"/>
        <dyn:precompiledModels useStandardModels="true"/>
        <dyn:modelicaModels useStandardModels="true">
          <dyn:directory path="." recursive="false"/>
        </dyn:modelicaModels>
      </dyn:modeler>
      <dyn:simulation startTime="0" stopTime="10"/>
      <dyn:outputs directory="outputsTestCaseGovHydroWPID">
        <dyn:curves inputFile="TestCaseGovHydroWPID.crv" exportMode="CSV"/>
        <dyn:logs> <dyn:appender tag="" file="dynawo.log" lvlFilter="INFO"/> </dyn:logs>
      </dyn:outputs>
  </dyn:job>
</dyn:jobs>
