<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <!-- Third-order synchronous machine with a GovHydro3 governor -->
  <set id="SynchronousGenerator">
    <!-- Generator -->
    <par type="DOUBLE" name="generator_H" value="4.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.003"/>
    <par type="DOUBLE" name="generator_XdPu" value="2.0"/>
    <par type="DOUBLE" name="generator_XpdPu" value="0.3"/>
    <par type="DOUBLE" name="generator_XqPu" value="1.9"/>
    <par type="DOUBLE" name="generator_Tpd0" value="7.0"/>
    <par type="DOUBLE" name="generator_SNom" value="100.0"/>
    <par type="DOUBLE" name="generator_P0Pu" value="-0.7"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="generator_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="generator_UPhase0" value="0.0"/>
    <!-- Governor -->
    <par type="BOOL" name="governor_GovernorControl" value="true"/>
    <par type="DOUBLE" name="governor_K1" value="0.01"/>
    <par type="DOUBLE" name="governor_K2" value="2.5"/>
    <par type="DOUBLE" name="governor_Kg" value="2.0"/>
    <par type="DOUBLE" name="governor_Ki" value="0.5"/>
    <par type="DOUBLE" name="governor_tD" value="0.05"/>
    <par type="DOUBLE" name="governor_tF" value="0.1"/>
    <par type="DOUBLE" name="governor_tP" value="0.05"/>
    <par type="DOUBLE" name="governor_tT" value="0.2"/>
    <par type="DOUBLE" name="governor_PMax" value="1.0"/>
    <par type="DOUBLE" name="governor_PMin" value="0.0"/>
    <par type="DOUBLE" name="governor_VelOp" value="0.2"/>
    <par type="DOUBLE" name="governor_VelCl" value="-0.2"/>
    <par type="DOUBLE" name="governor_RElec" value="0.05"/>
    <par type="DOUBLE" name="governor_RGate" value="0.0"/>
    <par type="DOUBLE" name="governor_DeltaOmegaDbPu" value="0.0"/>
    <par type="DOUBLE" name="governor_ATurb" value="1.2"/>
    <par type="DOUBLE" name="governor_H0" value="1.0"/>
    <par type="DOUBLE" name="governor_QNl" value="0.08"/>
    <par type="DOUBLE" name="governor_DTurb" value="0.2"/>
    <par type="DOUBLE" name="governor_tW" value="1.0"/>
    <par type="DOUBLE" name="governor_tDeriv" value="0.01"/>
  </set>
  <!-- OmegaRef -->
  <set id="OmegaRef">
    <par type="INT" name="nbGen" value="1"/>
    <par type="DOUBLE" name="weight_gen_0" value="100.0"/>
  </set>
  <!-- Load -->
  <set id="Load">
    <par type="DOUBLE" name="load_P0Pu" value="0.7"/>
    <par type="DOUBLE" name="load_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="load_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="load_UPhase0" value="0.0"/>
    <par type="DOUBLE" name="load_alpha" value="2.0"/>
    <par type="DOUBLE" name="load_beta" value="2.0"/>
  </set>
  <!-- Step on active load -->
  <set id="StepP">
    <par type="DOUBLE" name="step_Value0" value="0.7"/>
    <par type="DOUBLE" name="step_Height" value="0.05"/>
    <par type="DOUBLE" name="step_tStep" value="1.0"/>
  </set>
  <!-- IDA order 2 solver -->
  <set id="IDA">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="0.000001"/>
    <par type="DOUBLE" name="minStep" value="0.000001"/>
    <par type="DOUBLE" name="maxStep" value="1"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-6"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-6"/>
  </set>
</parametersSet>
