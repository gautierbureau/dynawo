<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="SynchronousGenerator">
    <par type="DOUBLE" name="generator_H" value="4.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.003"/>
    <par type="DOUBLE" name="generator_XdPu" value="2.0"/>
    <par type="DOUBLE" name="generator_XpdPu" value="0.3"/>
    <par type="DOUBLE" name="generator_XqPu" value="1.9"/>
    <par type="DOUBLE" name="generator_Tpd0" value="7.0"/>
    <par type="DOUBLE" name="generator_SNom" value="100.0"/>
    <par type="DOUBLE" name="generator_P0Pu" value="-0.7"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="generator_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="generator_UPhase0" value="0.0"/>
    <!-- Governor (GovSteamFV4: detailed steam governor with multi-stage cascade + actuator chain + torsional feedback loop disabled for this test) -->
    <par type="DOUBLE" name="governor_R"     value="0.05"/>
    <par type="DOUBLE" name="governor_t1"    value="0.1"/>
    <par type="DOUBLE" name="governor_t2"    value="0.5"/>
    <par type="DOUBLE" name="governor_t3"    value="0.5"/>
    <par type="DOUBLE" name="governor_t4"    value="0.5"/>
    <par type="DOUBLE" name="governor_t5"    value="0.5"/>
    <par type="DOUBLE" name="governor_t6"    value="0.5"/>
    <par type="DOUBLE" name="governor_t7"    value="0.5"/>
    <par type="DOUBLE" name="governor_tA"    value="0.1"/>
    <par type="DOUBLE" name="governor_tC"    value="0.1"/>
    <par type="DOUBLE" name="governor_tY"    value="0.1"/>
    <par type="DOUBLE" name="governor_tT"    value="0.1"/>
    <par type="DOUBLE" name="governor_tF2"   value="0.05"/>
    <par type="DOUBLE" name="governor_Kf1"   value="0.0"/>
    <par type="DOUBLE" name="governor_Kf2"   value="0.0"/>
    <par type="DOUBLE" name="governor_K"     value="1.0"/>
    <par type="DOUBLE" name="governor_K1"    value="0.3"/>
    <par type="DOUBLE" name="governor_K2"    value="0.4"/>
    <par type="DOUBLE" name="governor_K3"    value="0.3"/>
    <par type="DOUBLE" name="governor_K4"    value="0.0"/>
    <par type="DOUBLE" name="governor_Rsmimx" value="1.0"/>
    <par type="DOUBLE" name="governor_Rsmimn" value="0.0"/>
    <par type="DOUBLE" name="governor_Vvmax" value="1.0"/>
    <par type="DOUBLE" name="governor_Vvmin" value="0.0"/>
    <par type="DOUBLE" name="governor_Cpsmx" value="1.0"/>
    <par type="DOUBLE" name="governor_Cpsmn" value="0.0"/>
    <par type="DOUBLE" name="governor_Dp"    value="0.05"/>
    <par type="DOUBLE" name="governor_Lpsp"  value="1.0"/>
    <par type="DOUBLE" name="governor_Ovex"  value="1.5"/>
  </set>
  <set id="OmegaRef">
    <par type="INT" name="nbGen" value="1"/>
    <par type="DOUBLE" name="weight_gen_0" value="100.0"/>
  </set>
  <set id="Load">
    <par type="DOUBLE" name="load_P0Pu" value="0.7"/>
    <par type="DOUBLE" name="load_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="load_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="load_UPhase0" value="0.0"/>
    <par type="DOUBLE" name="load_alpha" value="2.0"/>
    <par type="DOUBLE" name="load_beta" value="2.0"/>
  </set>
  <set id="StepP">
    <par type="DOUBLE" name="step_Value0" value="0.7"/>
    <par type="DOUBLE" name="step_Height" value="0.02"/>
    <par type="DOUBLE" name="step_tStep" value="1.0"/>
  </set>
  <set id="IDA">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="0.000001"/>
    <par type="DOUBLE" name="minStep" value="0.000001"/>
    <par type="DOUBLE" name="maxStep" value="1"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
  </set>
</parametersSet>
