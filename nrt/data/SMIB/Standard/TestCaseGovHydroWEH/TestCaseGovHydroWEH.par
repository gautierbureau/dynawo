<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="SynchronousGenerator">
    <par type="DOUBLE" name="generator_H" value="4.0"/>
    <par type="DOUBLE" name="generator_DPu" value="1.0"/>
    <par type="DOUBLE" name="generator_RaPu" value="0.003"/>
    <par type="DOUBLE" name="generator_XdPu" value="2.0"/>
    <par type="DOUBLE" name="generator_XpdPu" value="0.3"/>
    <par type="DOUBLE" name="generator_XqPu" value="1.9"/>
    <par type="DOUBLE" name="generator_Tpd0" value="7.0"/>
    <par type="DOUBLE" name="generator_SNom" value="100.0"/>
    <par type="DOUBLE" name="generator_P0Pu" value="-0.7"/>
    <par type="DOUBLE" name="generator_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="generator_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="generator_UPhase0" value="0.0"/>
    <!-- Governor (GovHydroWEH: Woodward Electronic hydro governor with PI + permanent droop on speed & gate + non-minimum-phase water column) -->
    <par type="DOUBLE" name="governor_Reg"    value="1.0"/>
    <par type="DOUBLE" name="governor_Rpg"    value="0.04"/>
    <par type="DOUBLE" name="governor_Rpp"    value="0.04"/>
    <par type="DOUBLE" name="governor_tP"     value="0.05"/>
    <par type="DOUBLE" name="governor_tD"     value="0.1"/>
    <par type="DOUBLE" name="governor_tD2"    value="0.05"/>
    <par type="DOUBLE" name="governor_tF"     value="5.0"/>
    <par type="DOUBLE" name="governor_tG"     value="0.2"/>
    <par type="DOUBLE" name="governor_tW"     value="1.0"/>
    <par type="DOUBLE" name="governor_Gtmxop" value="0.1"/>
    <par type="DOUBLE" name="governor_Gtmxcl" value="0.1"/>
    <par type="DOUBLE" name="governor_Gpmax"  value="1.0"/>
    <par type="DOUBLE" name="governor_GMax"   value="1.0"/>
    <par type="DOUBLE" name="governor_GMin"   value="0.0"/>
    <par type="DOUBLE" name="governor_PMax"   value="1.0"/>
    <par type="DOUBLE" name="governor_PMin"   value="0.0"/>
    <par type="DOUBLE" name="governor_Pmss1"  value="0.0"/>
    <par type="DOUBLE" name="governor_Pmss2"  value="0.1"/>
    <par type="DOUBLE" name="governor_Pmss3"  value="0.2"/>
    <par type="DOUBLE" name="governor_Pmss4"  value="0.3"/>
    <par type="DOUBLE" name="governor_Pmss5"  value="0.4"/>
    <par type="DOUBLE" name="governor_Pmss6"  value="0.5"/>
    <par type="DOUBLE" name="governor_Pmss7"  value="0.6"/>
    <par type="DOUBLE" name="governor_Pmss8"  value="0.7"/>
    <par type="DOUBLE" name="governor_Pmss9"  value="0.85"/>
    <par type="DOUBLE" name="governor_Pmss10" value="1.0"/>
    <par type="DOUBLE" name="governor_Dpv"    value="0.05"/>
    <par type="DOUBLE" name="governor_Dicn"   value="0.0"/>
    <par type="DOUBLE" name="governor_Dspv"   value="0.001"/>
    <par type="DOUBLE" name="governor_FeedbackSignal" value="0.0"/>
  </set>
  <set id="OmegaRef">
    <par type="INT" name="nbGen" value="1"/>
    <par type="DOUBLE" name="weight_gen_0" value="100.0"/>
  </set>
  <set id="Load">
    <par type="DOUBLE" name="load_P0Pu" value="0.7"/>
    <par type="DOUBLE" name="load_Q0Pu" value="0.0"/>
    <par type="DOUBLE" name="load_U0Pu" value="1.0"/>
    <par type="DOUBLE" name="load_UPhase0" value="0.0"/>
    <par type="DOUBLE" name="load_alpha" value="2.0"/>
    <par type="DOUBLE" name="load_beta" value="2.0"/>
  </set>
  <set id="StepP">
    <par type="DOUBLE" name="step_Value0" value="0.7"/>
    <par type="DOUBLE" name="step_Height" value="0.02"/>
    <par type="DOUBLE" name="step_tStep" value="1.0"/>
  </set>
  <set id="IDA">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="0.000001"/>
    <par type="DOUBLE" name="minStep" value="0.000001"/>
    <par type="DOUBLE" name="maxStep" value="1"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-4"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-4"/>
  </set>
</parametersSet>
