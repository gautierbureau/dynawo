<dyn:dynamicModelsArchitecture xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:blackBoxModel id="busInf" lib="InfiniteBus" parFile="SMIB.par" parId="1"/>
  <dyn:blackBoxModel id="line" lib="Line" parFile="SMIB.par" parId="2"/>
  <dyn:blackBoxModel id="GEN" lib="GeneratorRoundRotorExp" parFile="SMIB.par" parId="3"/>
  <dyn:blackBoxModel id="omegaRef" lib="SetPoint" parFile="SMIB.par" parId="4"/>
  <dyn:blackBoxModel id="fault" lib="NodeFault" parFile="SMIB.par" parId="5"/>
  <dyn:connect id1="busInf" var1="infiniteBus_terminal" id2="line" var2="line_terminal1"/>
  <dyn:connect id1="line" var1="line_terminal2" id2="GEN" var2="generator_terminal"/>
  <dyn:connect id1="omegaRef" var1="setPoint_setPoint" id2="GEN" var2="generator_omegaRefPu"/>
  <dyn:connect id1="fault" var1="fault_terminal" id2="GEN" var2="generator_terminal"/>
</dyn:dynamicModelsArchitecture>
