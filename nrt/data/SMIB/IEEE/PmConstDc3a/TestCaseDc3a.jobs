<dyn:jobs xmlns:dyn="http://www.rte-france.com/dynawo">
  <dyn:job name="TestCaseDc3a - SMIB mild fault">
    <dyn:solver lib="dynawo_SolverIDA" parFile="TestCaseDc3a.par" parId="IDAOrder2"/>
    <dyn:modeler compileDir="outputsTestCaseDc3a/compilation">
      <dyn:dynModels dydFile="TestCaseDc3a.dyd"/>
      <dyn:precompiledModels useStandardModels="true"/>
      <dyn:modelicaModels useStandardModels="true">
        <dyn:directory path="." recursive="false"/>
      </dyn:modelicaModels>
    </dyn:modeler>
    <dyn:simulation startTime="0" stopTime="10"/>
    <dyn:outputs directory="outputsTestCaseDc3a">
      <dyn:curves inputFile="TestCaseDc3a.crv" exportMode="CSV"/>
      <dyn:logs><dyn:appender tag="" file="dynawo.log" lvlFilter="INFO"/></dyn:logs>
    </dyn:outputs>
  </dyn:job>
</dyn:jobs>
